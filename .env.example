PUBLIC_SANITY_PROJECT_ID=e6out5at
PUBLIC_SANITY_DATASET=production

# GA4 — live WP ID (public measurement ID). Also set in Cloudflare Pages → Settings → Environment variables.
# Banner + Consent Mode v2 ship even if empty; gtag.js loads only when set AND user consents.
PUBLIC_GA4_MEASUREMENT_ID=G-LJ12W6K8SS

SANITY_API_READ_TOKEN=

# Write token — migration + Studio mutations
# Create: sanity.io/manage → e6out5at → API → Tokens → Add → Editor
SANITY_API_WRITE_TOKEN=

# Affiliate product DB (same as old WP thi-affiliate engine)
# Local SQLite from Python sync: thi/affiliate/sync/affiliate_sync.py
AFFILIATE_DB_PATH=../affiliate/db/products.db
AWIN_PUBLISHER_ID=694187

# Optional: hosted copy for Cloudflare Pages builds (sync products.db → Turso)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Daisycon (later — not in WP engine yet)
DAISYCON_FEED_URL=

# Local prototype only — never set on Pages / production builds
# ALLOW_FIXTURES=1
