---
/**
 * Calm sitewide affiliate disclosure under nav (WC trust chrome, THI voice).
 * Methode lives here (not in primary nav) to avoid IA duplication.
 */
---

<aside class="thi-disc" aria-label="Affiliate-vermelding">
  <p class="thi-disc-inner">
    We verdienen via affiliate-links — dat verandert onze ranking niet.
    <a href="/affiliate-disclosure/">Hoe wij verdienen</a>
    <span class="thi-disc-sep" aria-hidden="true">·</span>
    <a href="/methode/">Methode</a>
  </p>
</aside>

<style is:global>
  .thi-disc {
    background: var(--cream);
    border-bottom: 1px solid var(--cream-3);
  }
  .thi-disc-inner {
    max-width: var(--site-wide);
    margin: 0 auto;
    padding: 7px var(--site-gutter);
    font: 400 12px/1.45 var(--font-body);
    color: var(--body);
  }
  .thi-disc-inner a {
    color: var(--green-900);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 700;
  }
  .thi-disc-inner a:hover { color: var(--green-700); }
  .thi-disc-sep {
    margin: 0 6px;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .thi-disc-inner { font-size: 11.5px; }
  }
</style>
