---
/**
 * YMYL / E-E-A-T author box: Wirecutter-style trust chrome at article end.
 * Pair with GuideByline at the top (max 2 author surfaces). Dates stay in the byline.
 */
import { urlFor } from '../lib/sanity';
import type { Author } from '../types';

interface Props {
  author: Author;
  variant?: 'full' | 'compact';
}

const { author, variant = 'full' } = Astro.props;

const photo = author.avatar
  ? urlFor(author.avatar).width(160).height(160).fit('crop').auto('format').url()
  : null;

function initials(name?: string): string {
  if (!name) return '?';
  return name.split(' ').map(p => p[0]).slice(0, 2).join('').toUpperCase();
}

const role = author.credentials || 'Oprichter';
const bio =
  author.bio ||
  'Schrijft de gidsen van The Health Issue. Oordeel eerst, trade-offs erbij, affiliate zichtbaar.';
---

<aside class:list={['author-box', { 'author-box--compact': variant === 'compact' }]} aria-label="Over de auteur">
  <div class="author-box-photo">
    {photo
      ? <img src={photo} alt="" width="80" height="80" loading="lazy" decoding="async" />
      : <span aria-hidden="true">{initials(author.name)}</span>}
  </div>
  <div class="author-box-body">
    <p class="author-box-kicker">Over de auteur</p>
    <p class="author-box-name">{author.name}</p>
    <p class="author-box-role">{role}</p>
    {variant === 'full' && <p class="author-box-bio">{bio}</p>}
    <p class="author-box-links">
      <a href="/over-ons/">Meer over The Health Issue</a>
      {author.instagram && (
        <>
          {' · '}
          <a href={author.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
        </>
      )}
    </p>
  </div>
</aside>
