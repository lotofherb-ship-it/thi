---
/**
 * Pain-Point Router face: Editorial Jump Board.
 * Predesigned chips only. Calm in-article Q&A, not messenger UI.
 * Routes to guide sections; never owns primary affiliate CTA.
 */
import type { ChatScript } from '../lib/chat-opener/types';
import { serializeChatScript } from '../lib/chat-opener/types';

interface Props {
  script: ChatScript;
  leadIn?: string;
  authorName?: string;
  authorAvatar?: string | null;
}

const {
  script,
  leadIn = 'Weinig tijd',
  authorName = 'Jouke',
  authorAvatar = null,
} = Astro.props;

const scriptJson = JSON.stringify(serializeChatScript(script));
const openingChips = script.openingChips.slice(0, 3);
const title = script.headline || 'Snel naar je oordeel';
const support =
  script.support ||
  'Kies een vraag. Je krijgt een kort oordeel en een sprong naar de juiste sectie.';
---

<aside
  class="ejb"
  id="chat-guide-opener"
  data-script={scriptJson}
  data-author-name={authorName}
  data-author-avatar={authorAvatar || ''}
  data-ejb-root
  role="region"
  aria-label={title}
>
  <p class="ejb-kicker">{leadIn}</p>
  <h2 class="ejb-title">{title}</h2>
  <p class="ejb-support">{support}</p>
  <p class="ejb-disc">{script.disclosure}</p>

  <div class="ejb-questions" data-ejb-questions role="group" aria-label="Voorgestelde vragen">
    {openingChips.map((c, i) => (
      <button
        type="button"
        class:list={['ejb-q', { 'ejb-q--decide': c.intentClass === 'decide' || i === 0 }]}
        data-chip-id={c.id}
        data-analytics-key={c.analyticsKey || c.id}
        data-intent={c.intentClass || ''}
      >
        <span class="ejb-q-label">{c.label}</span>
        <span class="ejb-q-mark" aria-hidden="true">↓</span>
      </button>
    ))}
  </div>

  <div class="ejb-panel" data-ejb-panel hidden>
    <div class="ejb-answer" data-ejb-answer></div>
    <div class="ejb-actions" data-ejb-actions></div>
    <div class="ejb-followups" data-ejb-followups role="group" aria-label="Vervolgvragen" hidden></div>
  </div>
</aside>

<style>
  .ejb {
    margin: 8px 0 32px;
    padding: 20px 0 4px;
    border-top: 1px solid var(--cream-3);
    width: 100%;
  }

  .ejb-kicker {
    margin: 0 0 6px;
    font: 700 12px/1.3 var(--font-body);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--sage, var(--body));
  }

  .ejb-title {
    margin: 0 0 8px;
    font: 700 22px/1.2 var(--font-head);
    letter-spacing: -0.015em;
    color: var(--text);
  }

  .ejb-support {
    margin: 0 0 8px;
    font: 400 15px/1.5 var(--font-body);
    color: var(--body);
    max-width: 38em;
  }

  .ejb-disc {
    margin: 0 0 16px;
    font: 400 12px/1.4 var(--font-body);
    color: var(--sage, var(--muted));
  }

  .ejb-questions {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--cream-3);
  }

  .ejb-q {
    appearance: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    margin: 0;
    padding: 14px 4px;
    min-height: 48px;
    border: none;
    border-bottom: 1px solid var(--cream-3);
    background: transparent;
    color: var(--text);
    font: 600 15px/1.35 var(--font-body);
    text-align: left;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .ejb-q--decide {
    box-shadow: inset 3px 0 0 var(--celery);
    padding-left: 12px;
  }

  .ejb-q:hover {
    background: color-mix(in oklab, var(--celery) 18%, var(--cream));
    color: var(--green-900);
  }

  .ejb-q.is-active {
    background: color-mix(in oklab, var(--celery) 28%, var(--cream));
    color: var(--green-900);
  }

  .ejb-q:disabled {
    opacity: 0.55;
    cursor: wait;
  }

  .ejb-q:focus-visible {
    outline: 2px solid var(--green-900);
    outline-offset: 2px;
  }

  .ejb-q-mark {
    flex-shrink: 0;
    font: 600 13px/1 var(--font-body);
    color: var(--sage, var(--muted));
  }

  .ejb-q.is-active .ejb-q-mark {
    color: var(--green-900);
  }

  .ejb-panel {
    margin-top: 16px;
    padding: 16px 16px 14px;
    border-left: 3px solid var(--celery);
    background: color-mix(in oklab, var(--celery) 12%, var(--cream));
    border-radius: 0 8px 8px 0;
  }

  .ejb-panel[hidden] {
    display: none;
  }

  .ejb-panel.is-enter {
    animation: ejb-in 0.2s ease-out;
  }

  :global(.ejb-verdict) {
    margin: 0;
    font: 400 15.5px/1.55 var(--font-body);
    color: var(--text);
  }

  :global(.ejb-sign) {
    display: block;
    margin-top: 10px;
    font: 600 12.5px/1.3 var(--font-body);
    color: var(--green-700, var(--green-900));
  }

  :global(.ejb-claim) {
    display: inline-block;
    margin-top: 8px;
    font: 600 11px/1.2 var(--font-body);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sage, var(--muted));
  }

  .ejb-actions {
    margin-top: 14px;
  }

  .ejb-actions:empty {
    display: none;
  }

  :global(.ejb-jump) {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border: none;
    background: none;
    padding: 0;
    min-height: 44px;
    font: 700 14px/1.3 var(--font-body);
    color: var(--cta-tertiary-ink, var(--green-900));
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  :global(.ejb-jump:hover) {
    color: var(--green-700, #2d5c20);
  }

  .ejb-followups {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid color-mix(in oklab, var(--cream-3) 70%, transparent);
  }

  .ejb-followups[hidden] {
    display: none;
  }

  :global(.ejb-fu) {
    appearance: none;
    border: 1px solid var(--cream-3);
    background: var(--white, #fff);
    color: var(--text);
    font: 600 13px/1.3 var(--font-body);
    padding: 9px 12px;
    min-height: 40px;
    border-radius: 8px;
    cursor: pointer;
    text-align: left;
  }

  :global(.ejb-fu:hover) {
    border-color: var(--green-900);
    color: var(--green-900);
  }

  :global(.ejb-fu:focus-visible) {
    outline: 2px solid var(--green-900);
    outline-offset: 2px;
  }

  :global(.ejb-fu--guard) {
    opacity: 0.8;
    border-style: dashed;
    font-weight: 500;
  }

  @keyframes ejb-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .ejb {
      margin-bottom: 28px;
    }
    .ejb-title {
      font-size: 20px;
    }
    .ejb-q {
      font-size: 14.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ejb-panel.is-enter {
      animation: none;
    }
  }
</style>

<script>
  function initEditorialJumpBoard(root) {
    const raw = root.dataset.script;
    if (!raw) return;

    const script = JSON.parse(raw);
    const authorName = root.dataset.authorName || 'Jouke';
    const questionsEl = root.querySelector('[data-ejb-questions]');
    const panel = root.querySelector('[data-ejb-panel]');
    const answerEl = root.querySelector('[data-ejb-answer]');
    const actionsEl = root.querySelector('[data-ejb-actions]');
    const followupsEl = root.querySelector('[data-ejb-followups]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let busy = false;
    let depth = 0;
    const MAX_DEPTH = 3;
    const MAX_FOLLOWUPS = 2;

    function track(event, payload) {
      const detail = Object.assign({ event: event, scriptId: script.id, depth: depth }, payload || {});
      window.dispatchEvent(new CustomEvent('thi:ppr', { detail: detail }));
      if (window.dataLayer && typeof window.dataLayer.push === 'function') {
        window.dataLayer.push(Object.assign({ event: 'thi_ppr_' + event }, detail));
      }
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'thi_ppr_' + event, detail);
      }
    }

    function labelFor(id) {
      if (script.labels && script.labels[id]) return script.labels[id];
      const open = (script.openingChips || []).find(function (c) {
        return c.id === id;
      });
      if (open) return open.label;
      return id;
    }

    function setActiveQuestion(chipId) {
      questionsEl.querySelectorAll('.ejb-q').forEach(function (btn) {
        btn.classList.toggle('is-active', btn.dataset.chipId === chipId);
      });
    }

    function claimLabel(mode) {
      if (mode === 'refuse') return 'Geen medisch advies';
      if (mode === 'authorized') return 'EU-claim';
      if (mode === 'opinion') return 'Redactioneel oordeel';
      return '';
    }

    function renderAnswer(node) {
      answerEl.innerHTML = '';
      const p = document.createElement('p');
      p.className = 'ejb-verdict';
      p.textContent = node.reply || '';
      answerEl.appendChild(p);

      if (node.signedBy === 'jouke') {
        const sign = document.createElement('span');
        sign.className = 'ejb-sign';
        sign.textContent = 'Jouke';
        answerEl.appendChild(sign);
      }

      const claim = claimLabel(node.claimMode);
      if (claim) {
        const tag = document.createElement('span');
        tag.className = 'ejb-claim';
        tag.textContent = claim;
        answerEl.appendChild(tag);
      }
    }

    function scrollToHref(href) {
      if (!href || href.charAt(0) !== '#') return false;
      const target = document.querySelector(href);
      if (!target) return false;
      target.scrollIntoView({
        behavior: reduceMotion ? 'auto' : 'smooth',
        block: 'start',
      });
      history.replaceState(null, '', href);
      return true;
    }

    function renderActions(node) {
      actionsEl.innerHTML = '';
      const handoffs = node.handoffs || [];
      const artifactHref = node.artifact && node.artifact.href;
      const primary =
        handoffs[0] ||
        (artifactHref
          ? { label: 'Alles wat we aanraden', href: artifactHref, analyticsKey: 'handoff_aanraden' }
          : null);
      if (!primary) return;

      const a = document.createElement('a');
      a.className = 'ejb-jump thi-cta thi-cta--tertiary';
      a.href = primary.href;
      a.textContent = primary.label + ' →';
      a.dataset.analyticsKey = primary.analyticsKey || 'handoff';
      a.addEventListener('click', function (ev) {
        track('handoff_click', {
          href: primary.href,
          label: primary.label,
          analyticsKey: primary.analyticsKey || 'handoff',
        });
        if (scrollToHref(primary.href)) ev.preventDefault();
      });
      actionsEl.appendChild(a);
    }

    function renderFollowups(node) {
      followupsEl.innerHTML = '';
      const items = (node.followUps || [])
        .filter(function (f) {
          const n = script.nodes[f.id];
          return n && n.depth <= MAX_DEPTH;
        })
        .slice(0, MAX_FOLLOWUPS);

      if (!items.length) {
        followupsEl.hidden = true;
        return;
      }

      items.forEach(function (item) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'ejb-fu';
        if (item.intentClass === 'guard') btn.classList.add('ejb-fu--guard');
        btn.dataset.chipId = item.id;
        btn.dataset.analyticsKey = item.analyticsKey || item.id;
        btn.textContent = item.label;
        followupsEl.appendChild(btn);
      });
      followupsEl.hidden = false;
    }

    function showPanel() {
      panel.hidden = false;
      panel.classList.remove('is-enter');
      void panel.offsetWidth;
      if (!reduceMotion) panel.classList.add('is-enter');
      panel.scrollIntoView({
        behavior: reduceMotion ? 'auto' : 'smooth',
        block: 'nearest',
      });
    }

    function respond(chipId, analyticsKey) {
      const node = script.nodes[chipId];
      if (!node || busy) return;

      const nextDepth = typeof node.depth === 'number' ? node.depth : depth + 1;
      if (nextDepth > MAX_DEPTH) return;

      busy = true;
      depth = nextDepth;
      setActiveQuestion(chipId);

      track('chip_click', {
        chipId: chipId,
        analyticsKey: analyticsKey || chipId,
        intent: node.claimMode,
        label: labelFor(chipId),
      });
      track('depth', { value: depth, chipId: chipId });
      track('answer_view', { chipId: chipId });

      renderAnswer(node);
      renderActions(node);
      renderFollowups(node);
      showPanel();
      busy = false;
    }

    questionsEl.addEventListener('click', function (e) {
      const btn = e.target.closest('[data-chip-id]');
      if (!btn || !btn.dataset.chipId || btn.disabled) return;
      respond(btn.dataset.chipId, btn.dataset.analyticsKey);
    });

    followupsEl.addEventListener('click', function (e) {
      const btn = e.target.closest('[data-chip-id]');
      if (!btn || !btn.dataset.chipId || btn.disabled) return;
      respond(btn.dataset.chipId, btn.dataset.analyticsKey);
    });
  }

  document.querySelectorAll('[data-ejb-root]').forEach(initEditorialJumpBoard);
</script>
