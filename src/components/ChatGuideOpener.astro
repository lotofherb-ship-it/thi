---
/**
 * Answer-first pick strip (Pain-Point Router face v3).
 * Named pick + trade-off + primary buy on first paint.
 * Optional filter chips reframe the verdict in place (not TOC / not chat).
 */
import type { PickStripScript, StripPick } from '../lib/chat-opener/pick-strip';
import { offerCta } from '../lib/products/resolve';

interface Props {
  strip: PickStripScript;
  picks: StripPick[];
  authorName?: string;
}

const { strip, picks, authorName = 'Jouke' } = Astro.props;

const pickMap = Object.fromEntries(picks.map(p => [p.key, p])) as Record<string, StripPick>;
const initial = strip.default;
const initialPick = pickMap[initial.pickKey] || picks[0];
const initialOffer = initialPick?.offers?.[0] || null;
const initialCta = initialOffer ? offerCta(initialOffer) : null;

const runtime = {
  id: strip.id,
  disclosure: strip.disclosure,
  shortlistLabel: strip.shortlistLabel,
  shortlistHref: strip.shortlistHref,
  authorName,
  default: strip.default,
  filters: strip.filters.slice(0, 2),
  picks: picks.map(p => ({
    key: p.key,
    name: p.name,
    offer: p.offers[0]
      ? {
          url: p.offers[0].url,
          action: offerCta(p.offers[0]).action,
          price: offerCta(p.offers[0]).price || '',
        }
      : null,
  })),
};
const runtimeJson = JSON.stringify(runtime);
---

<aside
  class="aps"
  id="chat-guide-opener"
  data-aps-root
  data-aps={runtimeJson}
  role="region"
  aria-label={initial.kicker}
>
  <p class="aps-kicker" data-aps-kicker>{initial.kicker}</p>
  <h2 class="aps-name" data-aps-name>{initialPick?.name || ''}</h2>
  <p class="aps-verdict" data-aps-verdict>{initial.verdict}</p>
  <p class="aps-trade" data-aps-trade>
    <span class="aps-trade-label">Trade-off</span>
    <span data-aps-trade-text>{initial.tradeOff}</span>
  </p>
  <p class="aps-sign">{authorName}</p>

  <div class="aps-cta" data-aps-cta>
    {initialOffer && initialCta ? (
      <a
        class="aps-buy thi-cta thi-cta--primary"
        data-aps-buy
        href={initialOffer.url}
        target="_blank"
        rel="noopener noreferrer nofollow sponsored"
      >
        <span class="thi-cta-action" data-aps-buy-action>{initialCta.action}</span>
        {initialCta.price ? (
          <span class="thi-cta-meta" data-aps-buy-price>{initialCta.price}</span>
        ) : null}
      </a>
    ) : (
      <p class="aps-missing">Koop-link volgt zodra de shop gekoppeld is.</p>
    )}
    <a
      class="aps-shortlist thi-cta thi-cta--secondary"
      href={strip.shortlistHref}
      data-aps-shortlist
    >
      {strip.shortlistLabel}
    </a>
  </div>

  {strip.filters.length > 0 && (
    <div class="aps-filters" data-aps-filters role="group" aria-label="Andere invalshoek">
      <button
        type="button"
        class="aps-filter is-active"
        data-filter-id="default"
        data-analytics-key="filter_default"
        aria-pressed="true"
      >
        Onze topkeuze
      </button>
      {strip.filters.map(f => (
        <button
          type="button"
          class="aps-filter"
          data-filter-id={f.id}
          data-analytics-key={f.analyticsKey || f.id}
          aria-pressed="false"
        >
          {f.label}
        </button>
      ))}
    </div>
  )}

  {strip.filters.length > 0 && (
    <p class="aps-disc">{strip.disclosure}</p>
  )}
</aside>

<style>
  .aps {
    margin: 0 0 28px;
    padding: 18px 0 4px;
    border-top: 1px solid var(--cream-3);
    width: 100%;
  }

  .aps-kicker {
    margin: 0 0 6px;
    font: 700 12px/1.3 var(--font-body);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--sage, var(--body));
  }

  .aps-name {
    margin: 0 0 10px;
    font: 700 24px/1.15 var(--font-head);
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .aps-verdict {
    margin: 0 0 10px;
    font: 400 16px/1.55 var(--font-body);
    color: var(--text);
    max-width: 38em;
  }

  .aps-trade {
    margin: 0 0 8px;
    font: 400 14.5px/1.45 var(--font-body);
    color: var(--body);
    max-width: 38em;
  }

  .aps-trade-label {
    font-weight: 700;
    color: var(--green-900);
    margin-right: 6px;
  }

  .aps-sign {
    margin: 0 0 16px;
    font: 600 12.5px/1.3 var(--font-body);
    color: var(--green-700, var(--green-900));
  }

  .aps-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 10px;
    margin-bottom: 14px;
  }

  .aps-buy {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    min-height: 48px;
    padding: 10px 16px;
    text-decoration: none;
  }

  .aps-shortlist {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 10px 14px;
    text-decoration: none;
  }

  .aps-missing {
    margin: 0;
    font: 400 14px/1.4 var(--font-body);
    color: var(--muted);
  }

  .aps-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 4px 0 10px;
  }

  .aps-filter {
    appearance: none;
    border: 1px solid var(--cream-3);
    background: var(--white, #fff);
    color: var(--text);
    font: 600 13px/1.3 var(--font-body);
    padding: 8px 12px;
    min-height: 40px;
    border-radius: 8px;
    cursor: pointer;
  }

  .aps-filter:hover {
    border-color: var(--green-900);
    color: var(--green-900);
  }

  .aps-filter.is-active {
    border-color: var(--green-900);
    background: color-mix(in oklab, var(--celery) 35%, var(--white, #fff));
    color: var(--green-900);
  }

  .aps-filter:focus-visible {
    outline: 2px solid var(--green-900);
    outline-offset: 2px;
  }

  .aps-disc {
    margin: 0;
    font: 400 12px/1.4 var(--font-body);
    color: var(--sage, var(--muted));
  }

  @media (max-width: 640px) {
    .aps-name {
      font-size: 21px;
    }
    .aps-verdict {
      font-size: 15px;
    }
    .aps-cta {
      flex-direction: column;
    }
    .aps-buy,
    .aps-shortlist {
      width: 100%;
    }
  }
</style>

<script>
  function initAnswerPickStrip(root) {
    const raw = root.dataset.aps;
    if (!raw) return;
    const data = JSON.parse(raw);

    const kickerEl = root.querySelector('[data-aps-kicker]');
    const nameEl = root.querySelector('[data-aps-name]');
    const verdictEl = root.querySelector('[data-aps-verdict]');
    const tradeTextEl = root.querySelector('[data-aps-trade-text]');
    const buyEl = root.querySelector('[data-aps-buy]');
    const buyActionEl = root.querySelector('[data-aps-buy-action]');
    const buyPriceEl = root.querySelector('[data-aps-buy-price]');
    const filtersEl = root.querySelector('[data-aps-filters]');

    function track(event, payload) {
      const detail = Object.assign({ event: event, scriptId: data.id }, payload || {});
      window.dispatchEvent(new CustomEvent('thi:ppr', { detail: detail }));
      if (window.dataLayer && typeof window.dataLayer.push === 'function') {
        window.dataLayer.push(Object.assign({ event: 'thi_ppr_' + event }, detail));
      }
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'thi_ppr_' + event, detail);
      }
    }

    track('strip_view', {});

    function pickByKey(key) {
      return (data.picks || []).find(function (p) { return p.key === key; }) || data.picks[0];
    }

    function applyState(state) {
      const pick = pickByKey(state.pickKey);
      if (kickerEl) kickerEl.textContent = state.kicker;
      if (nameEl) nameEl.textContent = pick ? pick.name : '';
      if (verdictEl) verdictEl.textContent = state.verdict;
      if (tradeTextEl) tradeTextEl.textContent = state.tradeOff;

      if (buyEl && pick && pick.offer) {
        buyEl.href = pick.offer.url;
        if (buyActionEl) buyActionEl.textContent = pick.offer.action;
        if (buyPriceEl) {
          if (pick.offer.price) {
            buyPriceEl.hidden = false;
            buyPriceEl.textContent = pick.offer.price;
          } else {
            buyPriceEl.hidden = true;
            buyPriceEl.textContent = '';
          }
        }
        buyEl.hidden = false;
      }
    }

    if (buyEl) {
      buyEl.addEventListener('click', function () {
        track('buy_click', { href: buyEl.href, pickName: nameEl ? nameEl.textContent : '' });
      });
    }

    const shortlist = root.querySelector('[data-aps-shortlist]');
    if (shortlist) {
      shortlist.addEventListener('click', function (ev) {
        track('shortlist_click', { href: shortlist.getAttribute('href') });
        const href = shortlist.getAttribute('href') || '';
        if (href.charAt(0) === '#') {
          const target = document.querySelector(href);
          if (target) {
            ev.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            history.replaceState(null, '', href);
          }
        }
      });
    }

    if (!filtersEl) return;

    filtersEl.addEventListener('click', function (e) {
      const btn = e.target.closest('[data-filter-id]');
      if (!btn) return;
      const id = btn.dataset.filterId;
      filtersEl.querySelectorAll('.aps-filter').forEach(function (b) {
        const on = b === btn;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });

      let state = data.default;
      if (id !== 'default') {
        const hit = (data.filters || []).find(function (f) { return f.id === id; });
        if (hit) state = hit;
      }
      applyState(state);
      track('filter_click', {
        filterId: id,
        analyticsKey: btn.dataset.analyticsKey || id,
        pickKey: state.pickKey,
      });
    });
  }

  document.querySelectorAll('[data-aps-root]').forEach(initAnswerPickStrip);
</script>
