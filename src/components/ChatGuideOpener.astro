---
/**
 * Pain-Point Router — inline editorial “Snel antwoord”.
 * Chips only (no composer). Jouke voice. SSR seed. Page-scroll over nested scroll.
 */
import type { ChatScript } from '../lib/chat-opener/types';
import { serializeChatScript } from '../lib/chat-opener/types';

interface Props {
  script: ChatScript;
  leadIn?: string;
  authorName?: string;
  authorAvatar?: string | null;
}

const {
  script,
  leadIn = 'Weinig tijd? Vraag het direct',
  authorName = 'Jouke',
  authorAvatar = null,
} = Astro.props;

const scriptJson = JSON.stringify(serializeChatScript(script));
const seed = script.seed;
const seedSigned = script.seedSignedBy === 'jouke';
const authorInitial = authorName.slice(0, 1).toUpperCase();
---

<aside
  class="cgo"
  id="chat-guide-opener"
  data-script={scriptJson}
  data-author-name={authorName}
  data-author-avatar={authorAvatar || ''}
  data-author-initial={authorInitial}
  data-cgo-root
  role="region"
  aria-label="Snel antwoord"
>
  <p class="cgo-leadin">{leadIn}</p>

  <div class="cgo-card" data-cgo-card>
    <header class="cgo-head">
      <div class="cgo-head-who">
        {authorAvatar ? (
          <img class="cgo-head-avatar" src={authorAvatar} alt="" width="36" height="36" />
        ) : (
          <span class="cgo-head-avatar cgo-head-avatar--fallback" aria-hidden="true">
            {authorInitial}
          </span>
        )}
        <div>
          <div class="cgo-head-title">Snel antwoord</div>
          <div class="cgo-head-sub">
            <span class="cgo-head-sub-primary">{authorName}</span>
            <span class="cgo-head-sub-sec"> · The Health Issue</span>
          </div>
        </div>
      </div>
      <p class="cgo-head-disc">{script.disclosure}</p>
    </header>

    <div class="cgo-body">
      <div
        class="cgo-thread"
        data-cgo-thread
        role="log"
        aria-live="polite"
        aria-relevant="additions"
      >
        <div class="cgo-msg cgo-msg--assistant" data-cgo-seed>
          <div class="cgo-msg-meta">
            {authorAvatar ? (
              <img class="cgo-avatar cgo-avatar--img" src={authorAvatar} alt="" width="22" height="22" />
            ) : (
              <span class="cgo-avatar" aria-hidden="true">{authorInitial}</span>
            )}
            <span class="cgo-who">{authorName}</span>
            <span class="cgo-who-sec">The Health Issue</span>
            <span class="cgo-time">nu</span>
          </div>
          <div class="cgo-bubble cgo-bubble--assistant">
            {seed}
            {seedSigned && <span class="cgo-sign">— Jouke</span>}
          </div>
        </div>
      </div>

      <div
        class="cgo-suggest"
        data-cgo-suggest
        role="group"
        aria-label="Voorgestelde vragen"
      >
        {script.openingChips.map(c => (
          <button
            type="button"
            class:list={['cgo-chip', { 'cgo-chip--primary': c.intentClass === 'decide' }]}
            data-chip-id={c.id}
            data-analytics-key={c.analyticsKey || c.id}
            data-intent={c.intentClass || ''}
          >
            {c.label}
          </button>
        ))}
      </div>
      <p class="cgo-chip-note">Antwoorden zijn vast · geen vrij typen</p>
    </div>
  </div>
</aside>

<button
  type="button"
  class="cgo-sticky"
  data-cgo-sticky
  hidden
  aria-label="Terug naar snel antwoord"
>
  Snel antwoord
</button>

<style>
  .cgo {
    margin: 0 0 28px;
    width: 100%;
  }

  .cgo-leadin {
    margin: 0 0 10px;
    font: 700 12.5px/1.3 var(--font-body);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sage, var(--body));
  }

  .cgo-card {
    border: 1px solid var(--cream-3);
    border-left: 4px solid var(--celery);
    border-radius: 14px;
    background: var(--cream);
    box-shadow:
      0 1px 0 rgba(28, 58, 19, 0.04),
      0 10px 28px rgba(28, 58, 19, 0.07);
    overflow: visible;
    display: flex;
    flex-direction: column;
  }

  .cgo-head {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px 12px;
    background: var(--white, #fff);
    border-bottom: 1px solid var(--cream-3);
    border-radius: 14px 14px 0 0;
  }

  .cgo-head-who {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .cgo-head-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid var(--celery);
  }
  .cgo-head-avatar--fallback {
    display: grid;
    place-items: center;
    background: var(--green-900);
    color: var(--celery);
    font: 700 14px/1 var(--font-head);
  }

  .cgo-head-title {
    font: 700 15px/1.2 var(--font-head);
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .cgo-head-sub {
    font: 400 12.5px/1.3 var(--font-body);
    color: var(--muted, var(--body));
    margin-top: 2px;
  }
  .cgo-head-sub-primary {
    font-weight: 700;
    color: var(--text);
  }
  .cgo-head-disc {
    margin: 0;
    font: 400 11.5px/1.4 var(--font-body);
    color: var(--sage, var(--body));
  }

  .cgo-body {
    display: flex;
    flex-direction: column;
    padding: 14px 14px 14px;
    background: var(--cream);
    border-radius: 0 0 14px 14px;
  }

  .cgo-thread {
    display: flex;
    flex-direction: column;
    gap: 12px;
    /* Grow with content — page scroll, not nested scroll */
    max-height: none;
    overflow: visible;
  }

  :global(.cgo-msg) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 94%;
    animation: cgo-in 0.28s ease-out;
  }
  :global(.cgo-msg--assistant) {
    align-self: flex-start;
    align-items: flex-start;
  }
  :global(.cgo-msg--user) {
    align-self: flex-end;
    align-items: flex-end;
  }
  :global(.cgo-msg--user.cgo-msg--send) {
    animation: cgo-send-in 0.32s ease-out;
  }

  :global(.cgo-msg-meta) {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  :global(.cgo-avatar) {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--green-900);
    color: var(--celery);
    display: grid;
    place-items: center;
    font: 700 10px/1 var(--font-head);
    flex-shrink: 0;
    overflow: hidden;
  }
  :global(.cgo-avatar--img) {
    object-fit: cover;
    border: 1px solid var(--celery);
    background: var(--cream);
  }
  :global(.cgo-who) {
    font: 700 11.5px/1.2 var(--font-body);
    color: var(--text);
  }
  :global(.cgo-who-sec) {
    font: 400 11px/1.2 var(--font-body);
    color: var(--muted, var(--body));
  }
  :global(.cgo-time) {
    font: 400 10.5px/1.2 var(--font-body);
    color: var(--muted, #8a9184);
  }

  :global(.cgo-bubble) {
    padding: 11px 13px;
    border-radius: 14px;
    font: 400 14.5px/1.5 var(--font-body);
    color: var(--text);
  }
  :global(.cgo-bubble--assistant) {
    background: var(--white, #fff);
    border: 1px solid var(--cream-3);
    border-bottom-left-radius: 4px;
    box-shadow: 0 1px 2px rgba(28, 58, 19, 0.04);
  }
  :global(.cgo-bubble--user) {
    background: var(--celery);
    color: var(--green-900);
    font-weight: 600;
    border-bottom-right-radius: 4px;
  }
  :global(.cgo-bubble.is-streaming) { min-height: 1.5em; }
  :global(.cgo-caret) {
    display: inline-block;
    width: 2px;
    height: 1em;
    margin-left: 1px;
    vertical-align: text-bottom;
    background: var(--green-900);
    animation: cgo-blink 0.8s steps(1) infinite;
  }

  :global(.cgo-sign) {
    display: block;
    margin-top: 6px;
    font: 600 11.5px/1.2 var(--font-body);
    color: var(--green-700, var(--green-900));
  }
  :global(.cgo-claim) {
    display: inline-block;
    margin-top: 6px;
    font: 600 10.5px/1.2 var(--font-body);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sage, var(--muted));
  }

  :global(.cgo-typing-row) {
    align-self: flex-start;
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 94%;
  }
  :global(.cgo-typing) {
    display: inline-flex;
    gap: 5px;
    align-items: center;
    padding: 12px 14px;
    border-radius: 14px;
    border-bottom-left-radius: 4px;
    background: var(--white, #fff);
    border: 1px solid var(--cream-3);
  }
  :global(.cgo-typing span) {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green-900);
    animation: cgo-dot 1.05s ease-in-out infinite;
  }
  :global(.cgo-typing span:nth-child(2)) { animation-delay: 0.15s; }
  :global(.cgo-typing span:nth-child(3)) { animation-delay: 0.3s; }
  :global(.cgo-typing-shimmer) { position: relative; overflow: hidden; }
  :global(.cgo-typing-shimmer::after) {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      transparent 20%,
      rgba(211, 250, 153, 0.35) 50%,
      transparent 80%
    );
    animation: cgo-shimmer 1.2s ease-in-out infinite;
  }

  :global(.cgo-tool) {
    align-self: flex-start;
    width: min(100%, 420px);
    animation: cgo-tool-in 0.4s ease-out;
  }
  :global(.cgo-tool-label) {
    margin: 0 0 6px;
    font: 600 10.5px/1.2 var(--font-body);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sage);
  }
  :global(.cgo-pick) {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 12px;
    align-items: start;
    padding: 12px;
    border-radius: 12px;
    border: 1px solid var(--cream-3);
    border-left: 3px solid var(--celery);
    background: var(--white, #fff);
    text-decoration: none;
    color: var(--text);
    box-shadow: 0 4px 14px rgba(28, 58, 19, 0.06);
  }
  :global(.cgo-pick:hover) { border-color: var(--green-900); }
  :global(.cgo-pick-img) {
    width: 64px;
    height: 64px;
    object-fit: contain;
    border-radius: 10px;
    background: var(--cream);
  }
  :global(.cgo-pick-img--empty) {
    display: grid;
    place-items: center;
    font: 700 11px/1 var(--font-body);
    color: var(--green-900);
    background: var(--celery);
  }
  :global(.cgo-pick-kicker) {
    margin: 0 0 2px;
    font: 700 10.5px/1.2 var(--font-body);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--green-900);
  }
  :global(.cgo-pick-name) {
    margin: 0 0 4px;
    font: 700 14px/1.25 var(--font-body);
  }
  :global(.cgo-pick-claim) {
    margin: 0 0 4px;
    font: 400 12.5px/1.35 var(--font-body);
    color: var(--body);
  }
  :global(.cgo-pick-price) {
    margin: 0 0 2px;
    font: 700 12.5px/1.3 var(--font-body);
    color: var(--text);
  }
  :global(.cgo-pick-trade) {
    margin: 0;
    font: 400 11.5px/1.35 var(--font-body);
    color: var(--muted, var(--body));
  }

  :global(.cgo-handoffs) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    animation: cgo-fade 0.35s ease-out;
  }
  :global(.cgo-handoff) {
    appearance: none;
    display: inline-flex;
    align-items: center;
    border: none;
    background: var(--green-900);
    color: var(--celery);
    font: 700 12.5px/1.25 var(--font-body);
    padding: 10px 12px;
    min-height: 40px;
    border-radius: 999px;
    text-decoration: none;
    cursor: pointer;
  }
  :global(.cgo-handoff:hover) { background: var(--green-700, #2d5c20); }

  .cgo-suggest {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 14px;
  }
  .cgo-suggest.is-followups {
    display: flex;
    flex-wrap: wrap;
  }
  .cgo-suggest.is-enter {
    animation: cgo-fade 0.4s ease-out;
  }
  .cgo-suggest[hidden] { display: none; }

  .cgo-chip-note {
    margin: 10px 0 0;
    font: 400 11.5px/1.35 var(--font-body);
    color: var(--muted, var(--body));
  }

  :global(.cgo-chip) {
    appearance: none;
    border: 1px solid var(--cream-3);
    background: var(--white, #fff);
    color: var(--text);
    font: 600 13px/1.3 var(--font-body);
    padding: 11px 12px;
    min-height: 44px;
    border-radius: 12px;
    cursor: pointer;
    text-align: left;
    transition: background 0.15s, border-color 0.15s, transform 0.12s;
  }
  :global(.cgo-chip--primary) {
    background: var(--celery);
    border-color: var(--celery-d, var(--celery));
    color: var(--green-900);
  }
  :global(.cgo-chip--primary:hover) {
    background: #fff;
    border-color: var(--green-900);
  }
  :global(.cgo-chip:hover) {
    background: color-mix(in oklab, var(--celery) 35%, var(--white, #fff));
    border-color: var(--celery-d, var(--celery));
    color: var(--green-900);
  }
  :global(.cgo-chip--guard) {
    opacity: 0.78;
    border-style: dashed;
    font-weight: 500;
  }
  :global(.cgo-chip:active) { transform: scale(0.98); }
  :global(.cgo-chip:disabled) {
    opacity: 0.45;
    cursor: wait;
  }
  :global(.cgo-chip:focus-visible) {
    outline: 2px solid var(--green-900);
    outline-offset: 2px;
  }

  /* Desktop-only quiet sticky — not a FAB on mobile */
  .cgo-sticky {
    position: fixed;
    right: max(20px, var(--site-gutter, 24px));
    bottom: 24px;
    z-index: 50;
    appearance: none;
    border: 1px solid var(--green-900);
    background: var(--cream);
    color: var(--green-900);
    font: 700 13px/1.2 var(--font-body);
    padding: 10px 14px;
    border-radius: 999px;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(28, 58, 19, 0.12);
  }
  .cgo-sticky:hover {
    background: var(--celery);
  }
  .cgo-sticky[hidden] { display: none !important; }

  @keyframes cgo-in {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes cgo-send-in {
    from { opacity: 0; transform: translateY(10px) scale(0.97); }
    to { opacity: 1; transform: none; }
  }
  @keyframes cgo-tool-in {
    from { opacity: 0; transform: translateY(10px) scale(0.97); }
    to { opacity: 1; transform: none; }
  }
  @keyframes cgo-fade {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes cgo-dot {
    0%, 80%, 100% { opacity: 0.35; transform: translateY(0); }
    40% { opacity: 1; transform: translateY(-3px); }
  }
  @keyframes cgo-shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }
  @keyframes cgo-blink {
    0%, 50% { opacity: 1; }
    50.01%, 100% { opacity: 0; }
  }

  @media (max-width: 640px) {
    .cgo { margin-bottom: 24px; }
    .cgo-suggest { grid-template-columns: 1fr 1fr; }
    :global(.cgo-chip) { font-size: 12.5px; padding: 10px; }
    :global(.cgo-bubble) { font-size: 13.5px; }
    :global(.cgo-msg) { max-width: 97%; }
    :global(.cgo-pick) { grid-template-columns: 52px 1fr; }
    :global(.cgo-pick-img) { width: 52px; height: 52px; }
    .cgo-sticky { display: none !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.cgo-msg),
    :global(.cgo-msg--user.cgo-msg--send),
    :global(.cgo-tool),
    .cgo-suggest.is-enter {
      animation: none;
    }
    :global(.cgo-typing span),
    :global(.cgo-typing-shimmer::after),
    :global(.cgo-caret) {
      animation: none;
    }
    :global(.cgo-chip:active) { transform: none; }
  }
</style>

<script>
  function initPainPointRouter(root) {
    const raw = root.dataset.script;
    if (!raw) return;

    const script = JSON.parse(raw);
    const authorName = root.dataset.authorName || 'Jouke';
    const authorAvatar = root.dataset.authorAvatar || '';
    const authorInitial = root.dataset.authorInitial || 'J';
    const thread = root.querySelector('[data-cgo-thread]');
    const suggestEl = root.querySelector('[data-cgo-suggest]');
    const sticky = document.querySelector('[data-cgo-sticky]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.matchMedia('(max-width: 640px)').matches;

    let busy = false;
    let depth = 0;
    let skipStream = false;
    const MAX_DEPTH = 3;

    function track(event, payload) {
      const detail = Object.assign({ event: event, scriptId: script.id, depth: depth }, payload || {});
      window.dispatchEvent(new CustomEvent('thi:ppr', { detail: detail }));
      if (window.dataLayer && typeof window.dataLayer.push === 'function') {
        window.dataLayer.push(Object.assign({ event: 'thi_ppr_' + event }, detail));
      }
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'thi_ppr_' + event, detail);
      }
    }

    function scrollIntoViewLatest() {
      const last = thread.lastElementChild;
      if (last) {
        last.scrollIntoView({
          behavior: reduceMotion ? 'auto' : 'smooth',
          block: 'nearest',
        });
      }
    }

    function labelFor(id) {
      if (script.labels && script.labels[id]) return script.labels[id];
      const open = (script.openingChips || []).find(function (c) { return c.id === id; });
      if (open) return open.label;
      return id;
    }

    function thinkDelay(reply) {
      if (reduceMotion) return 0;
      const len = (reply || '').length;
      return Math.round(500 + Math.min(500, len * 4));
    }

    function wait(ms) {
      return new Promise(function (resolve) {
        window.setTimeout(resolve, ms);
      });
    }

    function avatarHtml() {
      if (authorAvatar) {
        return '<img class="cgo-avatar cgo-avatar--img" src="' + authorAvatar + '" alt="" width="22" height="22" />';
      }
      return '<span class="cgo-avatar" aria-hidden="true">' + authorInitial + '</span>';
    }

    function setChips(items, isFollowup) {
      suggestEl.innerHTML = '';
      suggestEl.hidden = !(items && items.length);
      suggestEl.classList.toggle('is-followups', !!isFollowup);
      suggestEl.classList.remove('is-enter');
      void suggestEl.offsetWidth;
      if (items && items.length) suggestEl.classList.add('is-enter');

      (items || []).forEach(function (item) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'cgo-chip';
        if (item.intentClass === 'decide') btn.classList.add('cgo-chip--primary');
        if (item.intentClass === 'guard') btn.classList.add('cgo-chip--guard');
        btn.dataset.chipId = item.id;
        btn.dataset.analyticsKey = item.analyticsKey || item.id;
        if (item.intentClass) btn.dataset.intent = item.intentClass;
        btn.textContent = item.label;
        suggestEl.appendChild(btn);
      });
    }

    function disableChips(on) {
      suggestEl.querySelectorAll('button').forEach(function (b) {
        b.disabled = !!on;
      });
    }

    function appendUserMessage(text) {
      const msg = document.createElement('div');
      msg.className = 'cgo-msg cgo-msg--user cgo-msg--send';
      msg.innerHTML =
        '<div class="cgo-msg-meta"><span class="cgo-who">Jij</span><span class="cgo-time">nu</span></div>' +
        '<div class="cgo-bubble cgo-bubble--user"></div>';
      msg.querySelector('.cgo-bubble').textContent = text;
      thread.appendChild(msg);
      scrollIntoViewLatest();
      return msg;
    }

    function appendTyping() {
      const row = document.createElement('div');
      row.className = 'cgo-typing-row';
      row.setAttribute('data-cgo-typing-row', '');
      row.innerHTML =
        '<div class="cgo-msg-meta">' +
        avatarHtml() +
        '<span class="cgo-who">' + authorName + '</span>' +
        '<span class="cgo-who-sec">The Health Issue</span>' +
        '<span class="cgo-time">nu</span>' +
        '</div>' +
        '<div class="cgo-typing cgo-typing-shimmer" aria-label="Aan het typen">' +
        '<span></span><span></span><span></span>' +
        '</div>';
      thread.appendChild(row);
      scrollIntoViewLatest();
      return row;
    }

    function createAssistantShell() {
      const msg = document.createElement('div');
      msg.className = 'cgo-msg cgo-msg--assistant';
      msg.innerHTML =
        '<div class="cgo-msg-meta">' +
        avatarHtml() +
        '<span class="cgo-who">' + authorName + '</span>' +
        '<span class="cgo-who-sec">The Health Issue</span>' +
        '<span class="cgo-time">nu</span>' +
        '</div>' +
        '<div class="cgo-bubble cgo-bubble--assistant is-streaming" data-cgo-stream></div>';
      thread.appendChild(msg);
      scrollIntoViewLatest();
      return msg;
    }

    function appendMeta(bubbleEl, meta) {
      if (!meta) return;
      if (meta.signedBy === 'jouke') {
        const sign = document.createElement('span');
        sign.className = 'cgo-sign';
        sign.textContent = '— Jouke';
        bubbleEl.appendChild(sign);
      }
      if (meta.claimMode && meta.claimMode !== 'none') {
        const claim = document.createElement('span');
        claim.className = 'cgo-claim';
        claim.textContent =
          meta.claimMode === 'refuse'
            ? 'Geen medisch advies'
            : meta.claimMode === 'authorized'
              ? 'EU-claim'
              : 'Redactioneel oordeel';
        bubbleEl.appendChild(claim);
      }
    }

    async function streamText(bubbleEl, fullText, meta) {
      const words = (fullText || '').split(/(\s+)/).filter(Boolean);
      bubbleEl.textContent = '';
      bubbleEl.classList.add('is-streaming');

      const caret = document.createElement('span');
      caret.className = 'cgo-caret';
      caret.setAttribute('aria-hidden', 'true');

      const onSkip = function () { skipStream = true; };
      bubbleEl.addEventListener('click', onSkip);

      if (reduceMotion || skipStream) {
        bubbleEl.textContent = fullText;
        bubbleEl.classList.remove('is-streaming');
        appendMeta(bubbleEl, meta);
        bubbleEl.removeEventListener('click', onSkip);
        scrollIntoViewLatest();
        return;
      }

      let buf = '';
      for (let i = 0; i < words.length; i++) {
        if (skipStream) {
          bubbleEl.textContent = fullText;
          break;
        }
        buf += words[i];
        bubbleEl.textContent = buf;
        bubbleEl.appendChild(caret);
        scrollIntoViewLatest();
        const isSpace = /^\s+$/.test(words[i]);
        await wait(isSpace ? 18 : 28 + Math.min(40, words[i].length * 3));
      }

      bubbleEl.textContent = fullText;
      bubbleEl.classList.remove('is-streaming');
      appendMeta(bubbleEl, meta);
      bubbleEl.removeEventListener('click', onSkip);
      scrollIntoViewLatest();
    }

    function appendArtifact(artifact) {
      if (!artifact) return;
      const wrap = document.createElement('div');
      wrap.className = 'cgo-tool';
      wrap.innerHTML = '<p class="cgo-tool-label">Topkeuze · oordeel</p>';

      const a = document.createElement('a');
      a.className = 'cgo-pick';
      a.href = artifact.href || '#aanraden';
      a.dataset.analyticsKey = 'artifact_' + (artifact.kind || 'pick');

      if (artifact.imageUrl) {
        const img = document.createElement('img');
        img.className = 'cgo-pick-img';
        img.src = artifact.imageUrl;
        img.alt = '';
        img.width = 64;
        img.height = 64;
        img.loading = 'lazy';
        a.appendChild(img);
      } else {
        const ph = document.createElement('div');
        ph.className = 'cgo-pick-img cgo-pick-img--empty';
        ph.textContent = 'TOP';
        a.appendChild(ph);
      }

      const body = document.createElement('div');
      body.innerHTML =
        '<p class="cgo-pick-kicker">Topkeuze</p>' +
        '<p class="cgo-pick-name"></p>' +
        '<p class="cgo-pick-claim"></p>' +
        '<p class="cgo-pick-price"></p>' +
        '<p class="cgo-pick-trade"></p>';
      body.querySelector('.cgo-pick-name').textContent = artifact.product || '';
      body.querySelector('.cgo-pick-claim').textContent = artifact.claim || '';
      body.querySelector('.cgo-pick-price').textContent = artifact.priceLine || '';
      body.querySelector('.cgo-pick-trade').textContent = artifact.tradeOff
        ? 'Trade-off: ' + artifact.tradeOff
        : '';
      a.appendChild(body);

      a.addEventListener('click', function () {
        track('handoff_click', {
          href: a.href,
          label: 'artifact',
          analyticsKey: a.dataset.analyticsKey,
          kind: artifact.kind,
        });
      });

      wrap.appendChild(a);
      thread.appendChild(wrap);
      scrollIntoViewLatest();
    }

    function appendHandoffs(items) {
      if (!items || !items.length) return;
      const row = document.createElement('div');
      row.className = 'cgo-handoffs';
      items.forEach(function (h) {
        const a = document.createElement('a');
        a.className = 'cgo-handoff';
        a.href = h.href;
        a.textContent = h.label + ' →';
        a.dataset.analyticsKey = h.analyticsKey || 'handoff';
        a.addEventListener('click', function (ev) {
          track('handoff_click', {
            href: h.href,
            label: h.label,
            analyticsKey: h.analyticsKey || 'handoff',
          });
          if (h.href && h.href.charAt(0) === '#') {
            const target = document.querySelector(h.href);
            if (target) {
              ev.preventDefault();
              target.scrollIntoView({
                behavior: reduceMotion ? 'auto' : 'smooth',
                block: 'start',
              });
              history.replaceState(null, '', h.href);
            }
          }
        });
        row.appendChild(a);
      });
      thread.appendChild(row);
      scrollIntoViewLatest();
    }

    async function respond(chipId, analyticsKey, chipLabel) {
      const node = script.nodes[chipId];
      if (!node || busy) return;

      const nextDepth = typeof node.depth === 'number' ? node.depth : depth + 1;
      if (nextDepth > MAX_DEPTH) return;

      busy = true;
      skipStream = false;
      depth = nextDepth;

      const question = chipLabel || labelFor(chipId);
      disableChips(true);
      suggestEl.hidden = true;

      track('chip_click', {
        chipId: chipId,
        analyticsKey: analyticsKey || chipId,
        intent: node.claimMode,
      });
      track('depth', { value: depth, chipId: chipId });

      appendUserMessage(question);
      if (!reduceMotion) await wait(160);

      const typing = appendTyping();
      await wait(thinkDelay(node.reply));
      if (typing) typing.remove();

      const shell = createAssistantShell();
      const bubbleEl = shell.querySelector('[data-cgo-stream]');
      await streamText(bubbleEl, node.reply, {
        signedBy: node.signedBy,
        claimMode: node.claimMode,
      });

      if (node.artifact) {
        await wait(reduceMotion ? 0 : 200);
        appendArtifact(node.artifact);
      }
      if (node.handoffs && node.handoffs.length) {
        await wait(reduceMotion ? 0 : 100);
        appendHandoffs(node.handoffs);
      }

      const followUps = (node.followUps || []).filter(function (f) {
        const n = script.nodes[f.id];
        return n && n.depth <= MAX_DEPTH;
      });

      await wait(reduceMotion ? 0 : 240);
      if (followUps.length) setChips(followUps, true);
      else setChips(script.openingChips || [], false);
      disableChips(false);
      busy = false;
      scrollIntoViewLatest();
    }

    suggestEl.addEventListener('click', function (e) {
      const btn = e.target.closest('[data-chip-id]');
      if (!btn || !btn.dataset.chipId || btn.disabled) return;
      respond(btn.dataset.chipId, btn.dataset.analyticsKey, btn.textContent.trim());
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && busy) skipStream = true;
    });

    // Sticky: desktop only, after scrolling past module
    if (sticky && !isMobile) {
      function updateSticky() {
        const rect = root.getBoundingClientRect();
        sticky.hidden = !(rect.bottom < 0);
      }
      updateSticky();
      window.addEventListener('scroll', updateSticky, { passive: true });
      window.addEventListener('resize', updateSticky);
      sticky.addEventListener('click', function () {
        root.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
        track('skip_click', { fromDepth: depth, reentry: true });
      });
    } else if (sticky) {
      sticky.hidden = true;
    }
  }

  document.querySelectorAll('[data-cgo-root]').forEach(initPainPointRouter);
</script>
