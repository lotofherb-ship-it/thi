---
/**
 * Comparison / “best of” guide — Wirecutter structure + THI brand v2.
 * Two-pass picks: compact stack → short callouts → research → full chapters.
 * Brand: The Health Issue only. Cream/green + Bricolage/Lato.
 * Canonical URL: /{category}/{slug}/
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PortableText from './PortableText.astro';
import ChatGuideOpener from './ChatGuideOpener.astro';
import AuthorBox from './AuthorBox.astro';
import GuideByline from './GuideByline.astro';
import GuideToc from './GuideToc.astro';
import { urlFor } from '../lib/sanity';
import { categoryHref } from '../lib/urls';
import {
  resolveProducts,
  pickLabel,
  resolveProductImageUrl,
  offerCta,
  type ResolvedProduct,
} from '../lib/products/resolve';
import { getChatScriptForSlug } from '../lib/chat-opener';
import PickBuy from './PickBuy.astro';
import AudienceSplit from './AudienceSplit.astro';
import type { Post } from '../types';
import {
  articleSchema as buildArticleSchema,
  breadcrumbList,
  faqPageSchema,
  guessBrand,
  itemListSchema,
} from '../lib/schema';
import { postHref } from '../lib/urls';
import '../styles/guide.css';

interface Props {
  post: Post;
  recentPosts?: Post[];
}

const { post } = Astro.props;

const rawProducts = post.comparisonProducts || [];
const products = await resolveProducts(rawProducts);

const publishedLabel = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;
const updatedLabel = post.updatedAt
  ? new Date(post.updatedAt).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' })
  : publishedLabel;
const stampIso = post.updatedAt || post.publishedAt || undefined;

function productImage(p: ResolvedProduct): string | null {
  // No forced landscape crop — square/tall bottles stay contain-friendly
  const sanity = p.image
    ? urlFor(p.image).width(900).fit('max').auto('format').url()
    : null;
  return resolveProductImageUrl(p, sanity);
}

function productOffers(p: ResolvedProduct) {
  if (p.offers?.length) return p.offers;
  if (p.affiliateUrl) {
    return [{
      merchant: p.shop || 'Webshop',
      price: p.price || '',
      url: p.affiliateUrl,
      source: 'manual' as const,
    }];
  }
  return [];
}

const authorSrc = post.author?.avatar
  ? urlFor(post.author.avatar).width(160).height(160).fit('crop').auto('format').url()
  : null;

const bodyIntro = post.body?.slice(0, 2) || [];
const bodyRest = post.body && post.body.length > 2 ? post.body.slice(2) : [];

const disclosure =
  post.comparisonDisclosure ||
  'The Health Issue kan een commissie ontvangen via affiliate-links. Dat beïnvloedt onze redactionele keuzes niet.';

const specColumns = post.comparisonSpecColumns?.length
  ? post.comparisonSpecColumns
  : [
      { key: 'score', label: 'Score' },
      { key: 'prijs', label: 'Prijs' },
    ];

function specValue(p: ResolvedProduct, key: string): string {
  if (key === 'score') return typeof p.rating === 'number' ? `${p.rating}/5` : '—';
  if (key === 'prijs') return p.offers?.[0]?.price || p.price || '—';
  const hit = p.specs?.find(s => s.key === key);
  return hit?.value || '—';
}

/** Pain-Point Router — fixture registry until Sanity chatScript ships. */
const chatScript = getChatScriptForSlug(post.slug?.current);
const coverSrc =
  (chatScript ? chatScript.hero.photo : null) ||
  post.coverImageUrl ||
  null;
const topProduct = products[0] || null;
const topOffers = topProduct ? productOffers(topProduct) : [];
const topPrimary = topOffers[0] || null;
const topCta = topPrimary ? offerCta(topPrimary) : null;
const showRecThumbs = products.some(p => Boolean(productImage(p)));

/** Personas for “Wel voor jou” — never reuse keyTakeaways (those are quotable facts). */
const forItems = (
  post.whoFor?.length
    ? post.whoFor
    : [
        'Je een eerlijke topkeuze wilt zonder uren research',
        'Je wilt weten wat er wél en níet in het product zit',
        'Je prijs/kwaliteit belangrijker vindt dan marketing',
      ]
)
  .map(t => String(t).trim())
  .filter(Boolean);

const notItems = (
  post.notFor?.length
    ? post.notFor
    : [
        'Je medisch advies zoekt — raadpleeg dan een arts',
        'Je alleen op laagste prijs wilt selecteren',
        'Je claims zonder bronnen of nuance verwacht',
      ]
)
  .map(t => String(t).trim())
  .filter(Boolean);

const methodParagraphs = (post.methodProse || '')
  .split(/\n\s*\n/)
  .map(p => p.trim())
  .filter(Boolean);

const methodCriteria = (
  post.methodCriteria?.length
    ? post.methodCriteria
    : [
        'Samenstelling, dosering en vorm (capsule, poeder, vloeistof)',
        'Prijs per effectieve dosis, niet alleen stickerprijs',
        'Verkrijgbaarheid in NL-webshops via onze affiliate-feed',
        'Trade-offs zichtbaar: geen product is perfect voor iedereen',
      ]
)
  .map(t => String(t).trim())
  .filter(Boolean);

/** One TOC link per pick role — skip duplicate “Ook goed” entries. */
const tocPickLinks: { href: string; label: string }[] = [];
{
  const seen = new Set<string>();
  products.forEach((p, i) => {
    const { label } = pickLabel(p, i);
    if (seen.has(label)) return;
    seen.add(label);
    tocPickLinks.push({ href: `#pick-${i + 1}`, label });
  });
}

const tocItems: { href: string; label: string }[] = [];
if (products.length > 0) {
  if (chatScript) tocItems.push({ href: '#chat-guide-opener', label: 'Snel antwoord' });
  tocItems.push({ href: '#aanraden', label: 'Alles wat we aanraden' });
  tocPickLinks.forEach(link => tocItems.push(link));
  if (products.length > 1) tocItems.push({ href: '#vergelijking', label: 'Vergelijking' });
  tocItems.push({ href: '#vertrouwen', label: 'Waarom je ons kunt vertrouwen' });
  tocItems.push({ href: '#voor-wie', label: 'Voor wie dit is' });
  tocItems.push({ href: '#methode', label: 'Hoe we kozen' });
  if (post.alsoConsidered?.length) {
    tocItems.push({ href: '#concurrentie', label: 'Wat we ook bekeken' });
  }
  if (post.faq?.length) tocItems.push({ href: '#veelgestelde-vragen', label: 'Veelgestelde vragen' });
}

const pageUrl = postHref(post);
const articleSchema = buildArticleSchema({
  post,
  image: coverSrc,
  includeReviewedBy: Boolean(post.expertReviewer),
});
const faqSchema = faqPageSchema(post.faq);
const crumbSchema = breadcrumbList(post);
const listSchema = itemListSchema(
  products.map((p, i) => ({
    name: p.name,
    position: i + 1,
    url: p.reviewUrl || `${pageUrl}#pick-${i + 1}`,
    image: productImage(p),
    brand: guessBrand(p.name) || null,
  })),
);
---

<BaseLayout
  title={post.seoTitle || post.title}
  description={post.seoDescription || post.excerpt || ''}
  image={coverSrc || undefined}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(crumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  {listSchema && <script type="application/ld+json" set:html={JSON.stringify(listSchema)} />}

  <article class="guide" id="guide-start">
    <nav class="guide-crumb" aria-label="Kruimelpad">
      <a href="/">Home</a>
      <span class="guide-crumb-sep">/</span>
      {post.category && (
        <>
          <a href={categoryHref(post.category.slug.current)}>{post.category.title}</a>
          <span class="guide-crumb-sep">/</span>
        </>
      )}
      <span aria-current="page">{post.title}</span>
    </nav>

    <h1 class="guide-h1">{post.title}</h1>

    {post.excerpt && <p class="guide-lede guide-lede--standfirst">{post.excerpt}</p>}

    {post.author && (
      <GuideByline
        author={post.author}
        authorSrc={authorSrc}
        publishedLabel={publishedLabel}
        publishedIso={post.publishedAt}
        updatedLabel={updatedLabel}
        updatedIso={stampIso}
      />
    )}

    {/* Dense ATF shop strip — short label free, price on CTA */}
    {topProduct && topPrimary && topCta && (
      <div class="guide-atf-cue" aria-label="Snel naar topkeuze">
        <div class="guide-atf-cue-copy">
          <strong class="guide-atf-cue-name">{topProduct.name}</strong>
          <a class="guide-atf-cue-review thi-cta thi-cta--tertiary" href="#aanraden">Alles wat we aanraden</a>
        </div>
        <a
          class="guide-atf-cue-buy thi-cta thi-cta--primary"
          href={topPrimary.url}
          target="_blank"
          rel="noopener noreferrer nofollow sponsored"
        >
          <span class="guide-atf-cue-action thi-cta-action">{topCta.action}</span>
          {topCta.price ? (
            <span class="guide-atf-cue-meta thi-cta-meta">{topCta.price}</span>
          ) : null}
        </a>
      </div>
    )}

    <GuideToc items={tocItems} label="In deze gids" />

    {coverSrc && (
      <figure class="guide-hero">
        <img
          src={coverSrc}
          alt=""
          width="1200"
          height="675"
          sizes="(max-width: 820px) 100vw, 820px"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    )}

    {post.quickAnswer && (
      <aside class="guide-fyi" aria-label="Kort nieuws">
        <div class="guide-fyi-label">Goed om te weten</div>
        <p>{post.quickAnswer}</p>
      </aside>
    )}

    {bodyIntro.length > 0 && (
      <div class="guide-prose">
        <PortableText value={bodyIntro} />
      </div>
    )}

    {chatScript && (
      <ChatGuideOpener
        script={chatScript}
        leadIn="Weinig tijd? Vraag het direct"
        authorName={post.author?.name?.split(' ')[0] || 'Jouke'}
        authorAvatar={authorSrc}
      />
    )}

    {/* 1. Alles wat we aanraden — immediately after snel antwoord (P1-5) */}
    {products.length > 0 && (
      <section class="rec-stack" id="aanraden" aria-label="Alles wat we aanraden">
        <h2 class="rec-stack-title">Alles wat we aanraden</h2>
        <p class="rec-stack-dek">Korte shortlist — tik de knop voor actuele prijs bij de shop.</p>
        <ol class:list={['rec-stack-list', { 'rec-stack-list--thumbs': showRecThumbs }]}>
          {products.map((p, i) => {
            const { key, label } = pickLabel(p, i);
            const offers = productOffers(p);
            const primary = offers[0];
            const thumb = showRecThumbs ? productImage(p) : null;
            const cta = primary ? offerCta(primary) : null;
            return (
              <li class:list={['rec-stack-item', { 'rec-stack-item--top': key === 'top' }]} data-kind={key}>
                {showRecThumbs && (
                  thumb ? (
                    <a class="rec-stack-thumb" href={`#pick-${i + 1}`} tabindex="-1" aria-hidden="true">
                      <img src={thumb} alt="" width="56" height="56" loading={i === 0 ? 'eager' : 'lazy'} />
                    </a>
                  ) : (
                    <span class="rec-stack-thumb rec-stack-thumb--empty" aria-hidden="true" />
                  )
                )}
                <div class="rec-stack-main">
                  <div class="rec-stack-label">{label}</div>
                  {p.tagline && <div class="rec-stack-claim">{p.tagline}</div>}
                  <a class="rec-stack-name" href={`#pick-${i + 1}`}>{p.name}</a>
                </div>
                {primary && cta ? (
                  <a
                    class:list={[
                      'rec-stack-cta',
                      'thi-cta',
                      key === 'top' ? 'thi-cta--primary' : 'thi-cta--secondary',
                      { 'rec-stack-cta--top': key === 'top' },
                    ]}
                    href={primary.url}
                    target="_blank"
                    rel="noopener noreferrer nofollow sponsored"
                  >
                    <span class="rec-stack-cta-action">{cta.action}</span>
                    {cta.price ? (
                      <span class="rec-stack-cta-meta">
                        <span class="rec-stack-cta-price">{cta.price}</span>
                      </span>
                    ) : null}
                  </a>
                ) : (
                  <span class="rec-stack-cta rec-stack-cta--muted">Prijs volgt</span>
                )}
              </li>
            );
          })}
        </ol>
        <p class="rec-stack-foot">
          Partnerlink — commissie mogelijk, zelfde prijs voor jou.{' '}
          <a href="/affiliate-disclosure/">Meer info</a>
        </p>
      </section>
    )}

    {post.relatedCalculator && (
      <p class="guide-bridge">
        Eerst behoefte checken?
        <a href={post.relatedCalculator.href}>{post.relatedCalculator.title}</a>
        — daarna product kiezen.
      </p>
    )}

    {/* 2–4. Short pick callouts (verdict + trade-off, soft buy, images) — no pros/flaws yet */}
    {products.map((p, i) => {
      const { key, label } = pickLabel(p, i);
      const img = productImage(p);
      const offers = productOffers(p);

      return (
        <section class="pick pick--callout" id={`pick-${i + 1}`}>
          <span class="pick-label" data-kind={key}>{label}</span>
          <h2 class="pick-h2">
            {p.tagline ? `${p.tagline}: ` : ''}{p.name}
          </h2>

          <div class="pick-callout">
            <div class="pick-media">
              {img
                ? <img src={img} alt={p.name} width="640" height="480" loading={i === 0 ? 'eager' : 'lazy'} />
                : <span class="pick-media-empty" aria-hidden="true" />}
            </div>
            <div class="pick-meta">
              <h3 class="pick-product-name">{p.name}</h3>
              {(p.verdict || p.tagline) && (
                <p class="pick-summary">{p.verdict || p.tagline}</p>
              )}
              {p.pros?.length ? (
                <ul class="pick-scan-pros">
                  {p.pros.slice(0, 3).map(pro => <li>{pro}</li>)}
                </ul>
              ) : null}
              <PickBuy
                offers={offers}
                reviewUrl={p.reviewUrl}
              />
            </div>
          </div>
        </section>
      );
    })}

    {/* Soft mid-article CTA — one reminder after pick scan, before deep research */}
    {topProduct && topPrimary && topCta && (
      <aside class="guide-mid-cta" aria-label="Topkeuze">
        <div class="guide-mid-cta-copy">
          <strong class="guide-mid-cta-name">{topProduct.name}</strong>
          {topProduct.tagline && <span class="guide-mid-cta-claim">{topProduct.tagline}</span>}
        </div>
        <a
          class="guide-mid-cta-btn thi-cta thi-cta--primary"
          href={topPrimary.url}
          target="_blank"
          rel="noopener noreferrer nofollow sponsored"
        >
          <span class="guide-mid-cta-action thi-cta-action">{topCta.action}</span>
          {topCta.price ? (
            <span class="guide-mid-cta-meta thi-cta-meta">{topCta.price}</span>
          ) : null}
        </a>
      </aside>
    )}

    {/* Mid-guide research cluster */}
    {products.length > 1 && (
      <section id="vergelijking" class="guide-section">
        <h2>Hoe onze keuzes vergelijken</h2>
        <div class="guide-table-wrap">
          <table class="guide-table" aria-label="Productvergelijking">
            <thead>
              <tr>
                <th>Product</th>
                {specColumns.map(col => <th>{col.label}</th>)}
                <th></th>
              </tr>
            </thead>
            <tbody>
              {products.map((p, i) => {
                const offer = p.offers?.[0];
                const href = offer?.url || p.affiliateUrl;
                const { label } = pickLabel(p, i);
                return (
                  <tr class:list={[{ 'is-top': i === 0 }]}>
                    <td>
                      <div class="gt-name">{p.name}</div>
                      <div class="gt-sub">{label}</div>
                    </td>
                    {specColumns.map(col => (
                      <td>{specValue(p, col.key)}</td>
                    ))}
                    <td>
                      {href && offer ? (
                        <a class="gt-cta thi-cta thi-cta--primary" href={href} target="_blank" rel="noopener noreferrer nofollow sponsored">
                          <span class="gt-cta-action thi-cta-action">{offerCta(offer).action}</span>
                          {offer.price ? (
                            <span class="gt-cta-meta thi-cta-meta">{offer.price}</span>
                          ) : null}
                        </a>
                      ) : href ? (
                        <a class="gt-cta thi-cta thi-cta--primary" href={href} target="_blank" rel="noopener noreferrer nofollow sponsored">
                          <span class="gt-cta-action thi-cta-action">Bekijk</span>
                        </a>
                      ) : '-'}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <p class="pick-disc">{disclosure}</p>
      </section>
    )}

    <section class="guide-section" id="vertrouwen">
      <h2>Waarom je The Health Issue kunt vertrouwen</h2>
      {post.trustNarrative ? (
        <p>{post.trustNarrative}</p>
      ) : (
        <p>
          We schrijven keuzehulp voor gezondheidsproducten: oordeel eerst, trade-offs erbij,
          affiliate-geld zichtbaar bij elke koopoptie. {post.author?.name || 'Onze redactie'} selecteert
          op samenstelling, dosering, prijs/kwaliteit en bruikbaarheid — niet op commissiehoogte.
        </p>
      )}
      {post.expertReviewer && (
        <p>
          Medisch meeglezen door <strong>{post.expertReviewer.name}</strong>
          {post.expertReviewer.title ? ` (${post.expertReviewer.title})` : ''}.
          {post.expertReviewer.quote ? ` “${post.expertReviewer.quote}”` : ''}
        </p>
      )}
    </section>

    <section class="guide-section" id="voor-wie">
      <h2>Voor wie dit is (en voor wie niet)</h2>
      {post.whoForProse && <p>{post.whoForProse}</p>}
      <AudienceSplit
        forTitle="Wel voor jou als…"
        notTitle="Niet voor jou als…"
        forItems={forItems}
        notItems={notItems}
      />
    </section>

    <section class="guide-section" id="methode">
      <h2>Hoe we kozen</h2>
      {methodParagraphs.length > 0 ? (
        methodParagraphs.map(p => <p>{p}</p>)
      ) : (
        <>
          <p>
            We begonnen met wat mensen in Nederland écht kopen via gangbare webshops. Daarna
            filterden we op etikethelderheid (dosering per portie), vorm (poeder, tablet, capsule)
            en of de claim past bij het gebruik — niet op marketingtaal.
          </p>
          <p>
            Prijs beoordelen we per effectieve dosis — niet op de sticker. Affiliate-commissie speelt
            geen rol in de ranking: elke koopoptie toont de link en de bron. Producten die alleen via
            onduidelijke dropshippers lopen, vallen af.
          </p>
        </>
      )}
      {methodCriteria.length > 0 && (
        <ul>
          {methodCriteria.map(c => <li>{c}</li>)}
        </ul>
      )}
    </section>

    {/* Full pick chapters — prose + pros/flaws (second pass) */}
    {products.map((p, i) => {
      const { key, label } = pickLabel(p, i);
      const img = productImage(p);
      const offers = productOffers(p);

      return (
        <section class="pick pick--chapter" id={`pick-${i + 1}-detail`}>
          <span class="pick-label" data-kind={key}>{label} — uitgebreid</span>
          <h2 class="pick-h2">{p.name}</h2>

          <div class="pick-callout">
            <div class="pick-media">
              {img
                ? <img src={img} alt="" width="640" height="480" loading="lazy" />
                : <span class="pick-media-empty" aria-hidden="true" />}
            </div>
            <div class="pick-meta">
              {(p.verdict || p.tagline) && (
                <p class="pick-summary">{p.verdict || p.tagline}</p>
              )}
              {p.pros?.length ? (
                <ul class="pick-scan-pros">
                  {p.pros.slice(0, 3).map(pro => <li>{pro}</li>)}
                </ul>
              ) : null}
              <PickBuy
                offers={offers}
                reviewUrl={p.reviewUrl}
              />
            </div>
          </div>

          {(p.pros?.length || p.cons?.length) && (
            <div class="pick-pc">
              {p.pros?.length ? (
                <div class="pick-pros">
                  <h4>Waarom we het aanraden</h4>
                  <ul>{p.pros.map(pro => <li>{pro}</li>)}</ul>
                </div>
              ) : <div />}
              {p.cons?.length ? (
                <div class="pick-cons">
                  <h4>Waar we op letten</h4>
                  <ul>{p.cons.map(con => <li>{con}</li>)}</ul>
                </div>
              ) : <div />}
            </div>
          )}

          {p.cons?.length ? (
            <div class="pick-flaws">
              <h4>Minpunten, maar geen dealbreakers</h4>
              <p>{p.cons.join(' ')}</p>
            </div>
          ) : null}
        </section>
      );
    })}

    {/* Concurrentie / ook bekeken */}
    {post.alsoConsidered && post.alsoConsidered.length > 0 && (
      <section class="guide-section" id="concurrentie">
        <h2>Wat we ook bekeken</h2>
        <p>
          Niet alles haalde de shortlist. Kort waarom — zodat je ziet wat we wél hebben meegenomen
          in de afweging.
        </p>
        <ul class="guide-reject">
          {post.alsoConsidered.map(item => (
            <li>
              <strong>{item.name}</strong>
              <span>{item.blurb}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {post.keyTakeaways && post.keyTakeaways.length > 0 && (
      <div class="guide-kt">
        <h2>Wat je moet weten</h2>
        <ul>
          {post.keyTakeaways.map(item => <li>{item}</li>)}
        </ul>
      </div>
    )}

    {bodyRest.length > 0 && (
      <div class="guide-prose">
        <PortableText value={bodyRest} />
      </div>
    )}

    {post.faq && post.faq.length > 0 && (
      <div class="guide-faq" id="veelgestelde-vragen">
        <h2>Veelgestelde vragen</h2>
        {post.faq.map(item => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    )}

    {post.author && <AuthorBox author={post.author} variant="full" />}
  </article>
</BaseLayout>
