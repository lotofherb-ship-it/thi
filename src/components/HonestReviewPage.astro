---
/**
 * Honest review — long-form single-product editorial.
 * Not a multi-pick vergelijking clone (no “Alles wat we aanraden” stack).
 * Shared WC chrome: stamp, byline, one buy module. Brand v2 cream/green.
 * Canonical URL: /{category}/{slug}/
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PortableText from './PortableText.astro';
import ChatGuideOpener from './ChatGuideOpener.astro';
import AuthorBox from './AuthorBox.astro';
import GuideByline from './GuideByline.astro';
import GuideToc from './GuideToc.astro';
import { urlFor } from '../lib/sanity';
import { categoryHref } from '../lib/urls';
import { resolveProductCommerce, offerCta } from '../lib/products/resolve';
import { getChatScriptForSlug } from '../lib/chat-opener';
import PickBuy from './PickBuy.astro';
import AudienceSplit from './AudienceSplit.astro';
import type { Post, ComparisonProduct } from '../types';
import {
  breadcrumbList,
  faqPageSchema,
  guessBrand,
  reviewSchema,
} from '../lib/schema';
import '../styles/guide.css';

interface Props {
  post: Post;
  recentPosts?: Post[];
}

const { post } = Astro.props;
const hr = post.honestReview;
const scores = hr?.scores;
const productName = hr?.productName || post.title;

const heroSrc = post.heroImage
  ? urlFor(post.heroImage).width(960).height(540).fit('crop').auto('format').url()
  : null;

const authorSrc = post.author?.avatar
  ? urlFor(post.author.avatar).width(160).height(160).fit('crop').auto('format').url()
  : null;

const scoreDimensions = [
  { key: 'ingredients', label: 'Ingrediënten' },
  { key: 'dosage', label: 'Dosering' },
  { key: 'effect', label: 'Effect' },
  { key: 'value', label: 'Prijs/kwal.' },
  { key: 'taste', label: 'Smaak' },
] as const;

const activeScores = scores
  ? scoreDimensions.filter(d => scores[d.key] !== undefined)
  : [];

function scoreToWidth(val: number | undefined): string {
  return val ? `${(val / 10) * 100}%` : '0%';
}

const publishedLabel = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;
const updatedLabel = post.updatedAt
  ? new Date(post.updatedAt).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' })
  : publishedLabel;
const stampIso = post.updatedAt || post.publishedAt || undefined;

const synthetic: ComparisonProduct = {
  name: productName,
  rating: hr?.overallScore ? hr.overallScore / 2 : 0,
  imageUrl: hr?.imageUrl,
  tursoProductId: hr?.tursoProductId,
  // Manual commerce (PLNKT tidd.ly, Lot of Herb, Daisycon backup URLs) — must
  // reach resolve() or PickBuy shows the empty-feed stub forever.
  affiliateUrl: hr?.affiliateUrl,
  shop: hr?.shop,
  price: hr?.price,
};
const { offers, feedImageUrl } = await resolveProductCommerce(synthetic);
const primaryOffer = offers[0] || null;
const primaryCta = primaryOffer ? offerCta(primaryOffer) : null;

/** Pack shot: editorial URL → merchant feed → never landscape article hero as bottle. */
const productSrc = hr?.imageUrl || feedImageUrl || null;

/** Vertical TOC labels — slightly longer than old chip TOC is fine. */
function shortTocLabel(text: string): string {
  const t = text.trim();
  if (t.length <= 42) return t;
  const cut = t.slice(0, 40).replace(/\s+\S*$/, '');
  return `${cut || t.slice(0, 40)}…`;
}

const bodyTocItems = (post.body || [])
  .filter((b: any) => b._type === 'block' && b.style === 'h2')
  .map((b: any) => {
    const text = b.children?.map((c: any) => c.text).join('') || '';
    const id = text.toLowerCase().replace(/[^a-z0-9\s-]/g, '').trim().replace(/\s+/g, '-');
    return { href: `#${id}`, label: shortTocLabel(text) };
  });

const forItems = [
  ...(hr?.bestFor ? [hr.bestFor] : []),
  ...(post.keyTakeaways?.slice(0, 2) || []),
]
  .map(t => String(t).trim())
  .filter(Boolean);

const notFor =
  hr?.notFor?.length
    ? hr.notFor
    : [
        'Je medische claims of genezing verwacht',
        'Je alleen op de laagste stickerprijs wilt beslissen',
      ];

const chatScript = getChatScriptForSlug(post.slug?.current);
const articleHero = heroSrc || (chatScript ? chatScript.hero.photo : null);

const tocItems: { href: string; label: string }[] = [];
if (chatScript) tocItems.push({ href: '#chat-guide-opener', label: 'Snel antwoord' });
tocItems.push({ href: '#beoordeling', label: 'Beoordeling' });
tocItems.push({ href: '#voor-wie', label: 'Voor wie dit is' });
if (activeScores.length > 0) tocItems.push({ href: '#scores', label: 'Scores' });
bodyTocItems.forEach(item => tocItems.push(item));
if (hr?.weeklyEntries?.length) tocItems.push({ href: '#ervaringen', label: 'Ervaringen' });
if (hr?.pros?.length || hr?.cons?.length) tocItems.push({ href: '#plus-min', label: 'Plus en min' });
if (post.faq?.length) tocItems.push({ href: '#veelgestelde-vragen', label: 'Veelgestelde vragen' });

const reviewJsonLd = reviewSchema({
  post,
  productName,
  image: articleHero || productSrc,
  brand: guessBrand(productName) || null,
  reviewBody: hr?.verdict || post.excerpt || post.quickAnswer || null,
  // Only when visible score stamp exists in UI
  ratingValue: typeof hr?.overallScore === 'number' ? hr.overallScore : null,
  includeReviewedBy: Boolean(post.expertReviewer),
});
const faqSchema = faqPageSchema(post.faq);
const crumbSchema = breadcrumbList(post);
---

<BaseLayout
  title={post.seoTitle || post.title}
  description={post.seoDescription || post.excerpt || ''}
  image={articleHero || undefined}
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(reviewJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(crumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <article class="guide hr-article" id="guide-start">
    <nav class="guide-crumb" aria-label="Kruimelpad">
      <a href="/">Home</a>
      <span class="guide-crumb-sep">/</span>
      {post.category
        ? (
          <>
            <a href={categoryHref(post.category.slug.current)}>{post.category.title}</a>
            <span class="guide-crumb-sep">/</span>
          </>
        )
        : (
          <>
            <a href="/supplementen/">Supplementen</a>
            <span class="guide-crumb-sep">/</span>
          </>
        )}
      <span aria-current="page">{productName}</span>
    </nav>

    <h1 class="guide-h1">{post.title}</h1>

    {post.excerpt && <p class="guide-lede guide-lede--standfirst">{post.excerpt}</p>}

    {post.author && (
      <GuideByline
        author={post.author}
        authorSrc={authorSrc}
        publishedLabel={publishedLabel}
        publishedIso={post.publishedAt}
        updatedLabel={updatedLabel}
        updatedIso={stampIso}
        extraMeta={hr?.testPeriod ? `${hr.testPeriod} getest` : null}
      />
    )}

    {/* Dense ATF shop strip — no KOOPOPTIE eyebrow, price on CTA, one primary button */}
    {primaryOffer && primaryCta && (
      <div class="guide-atf-cue" aria-label="Snel naar shop">
        <div class="guide-atf-cue-copy">
          <strong class="guide-atf-cue-name">{productName}</strong>
          <a class="guide-atf-cue-review thi-cta thi-cta--tertiary" href="#beoordeling">Naar beoordeling</a>
        </div>
        <a
          class="guide-atf-cue-buy thi-cta thi-cta--primary"
          href={primaryOffer.url}
          target="_blank"
          rel="noopener noreferrer nofollow sponsored"
        >
          <span class="guide-atf-cue-action thi-cta-action">{primaryCta.action}</span>
          {primaryCta.price ? (
            <span class="guide-atf-cue-meta thi-cta-meta">{primaryCta.price}</span>
          ) : null}
        </a>
      </div>
    )}

    <GuideToc items={tocItems} label="In deze review" />

    {articleHero && (
      <figure class="guide-hero">
        <img
          src={articleHero}
          alt={productName}
          width="1200"
          height="675"
          sizes="(max-width: 820px) 100vw, 820px"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    )}

    {hr?.relatedComparison && (
      <p class="hr-parent-link">
        Onderdeel van
        <a href={hr.relatedComparison.href}>{hr.relatedComparison.title}</a>
      </p>
    )}

    {post.quickAnswer && (
      <aside class="guide-fyi" aria-label="Kort oordeel">
        <div class="guide-fyi-label">Kort oordeel</div>
        <p>{post.quickAnswer}</p>
      </aside>
    )}

    {chatScript && (
      <ChatGuideOpener
        script={chatScript}
        leadIn="Weinig tijd? Vraag het direct"
        authorName={post.author?.name?.split(' ')[0] || 'Jouke'}
        authorAvatar={authorSrc}
      />
    )}

    {/* Single-product hero — not a multi-pick stack */}
    <section class="pick" id="beoordeling">
      <span class="pick-label" data-kind="top">Onze beoordeling</span>
      <h2 class="pick-h2">{productName}</h2>
      {hr?.tagline && <p class="pick-summary" style="margin-bottom:14px">{hr.tagline}</p>}

      <div class="pick-callout">
        <div class="pick-media">
          {productSrc
            ? <img src={productSrc} alt={productName} width="640" height="640" loading="eager" />
            : <span class="pick-media-empty" aria-hidden="true" />}
        </div>
        <div class="pick-meta">
          <h3 class="pick-product-name">{productName}</h3>
          {hr?.bestFor && <p class="pick-summary">Beste voor: {hr.bestFor}</p>}
          {hr?.overallScore != null && (
            <div class="pick-score"><strong>{hr.overallScore}</strong>/10</div>
          )}
          {hr?.pros?.length ? (
            <ul class="pick-scan-pros">
              {hr.pros.slice(0, 3).map(pro => <li>{pro}</li>)}
            </ul>
          ) : null}
          <PickBuy
            offers={offers}
            emptyHint="Prijs/link volgt zodra Awin/Daisycon gekoppeld is."
          />
        </div>
      </div>
    </section>

    {post.relatedCalculator && (
      <p class="guide-bridge">
        Eerst behoefte checken?
        <a href={post.relatedCalculator.href}>{post.relatedCalculator.title}</a>
      </p>
    )}

    {hr?.verdict && (
      <section class="guide-section" id="verdict">
        <h2>Wat we ervan vinden</h2>
        <p>{hr.verdict}</p>
      </section>
    )}

    <section class="guide-section" id="voor-wie">
      <h2>Voor wie dit product is</h2>
      <AudienceSplit
        forTitle="Wel geschikt als…"
        notTitle="Minder geschikt als…"
        forItems={forItems}
        notItems={notFor}
      />
    </section>

    {/* Soft mid CTA after trust framing — not inside for/not-for */}
    {primaryOffer && primaryCta && (
      <aside class="guide-mid-cta" aria-label="Naar de shop">
        <div class="guide-mid-cta-copy">
          <strong class="guide-mid-cta-name">{productName}</strong>
          {hr?.bestFor && <span class="guide-mid-cta-claim">Beste voor: {hr.bestFor}</span>}
        </div>
        <a
          class="guide-mid-cta-btn thi-cta thi-cta--primary"
          href={primaryOffer.url}
          target="_blank"
          rel="noopener noreferrer nofollow sponsored"
        >
          <span class="guide-mid-cta-action thi-cta-action">{primaryCta.action}</span>
          {primaryCta.price ? (
            <span class="guide-mid-cta-meta thi-cta-meta">{primaryCta.price}</span>
          ) : null}
        </a>
      </aside>
    )}

    {hr?.overallScore != null && activeScores.length > 0 && (
      <section class="hr-score-strip" id="scores" aria-label="Scores">
        <div class="hr-score-big">
          <span class="hr-score-num">{hr.overallScore}</span>
          <span class="hr-score-max">/10</span>
        </div>
        <div class="hr-score-rows">
          {activeScores.map(({ key, label }) => {
            const val = scores![key];
            return (
              <div class="hr-score-row">
                <span>{label}</span>
                <div class="hr-score-bar" aria-hidden="true">
                  <div class="hr-score-fill" style={`width:${scoreToWidth(val)}`}></div>
                </div>
                <strong>{val}</strong>
              </div>
            );
          })}
        </div>
      </section>
    )}

    {post.keyTakeaways && post.keyTakeaways.length > 0 && (
      <div class="guide-kt">
        <h2>Wat je moet weten</h2>
        <ul>
          {post.keyTakeaways.map(item => <li>{item}</li>)}
        </ul>
      </div>
    )}

    {post.body && post.body.length > 0 && (
      <div class="guide-prose">
        <PortableText value={post.body} defaultOffer={primaryOffer} />
      </div>
    )}

    {hr?.weeklyEntries && hr.weeklyEntries.length > 0 && (
      <section class="guide-section" id="ervaringen">
        <h2>Ervaringen per week</h2>
        <ol class="hr-journal">
          {hr.weeklyEntries.map(entry => (
            <li class="hr-journal-item">
              <p class="hr-journal-week">
                Week {entry.week}{entry.title ? ` — ${entry.title}` : ''}
              </p>
              <p class="hr-journal-body">{entry.body}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {(hr?.pros?.length || hr?.cons?.length) && (
      <section class="guide-section" id="plus-min">
        <h2>Plus- en minpunten</h2>
        <div class="pick-pc">
          {hr.pros?.length ? (
            <div class="pick-pros">
              <h4>Wat goed werkt</h4>
              <ul>{hr.pros.map(pro => <li>{pro}</li>)}</ul>
            </div>
          ) : <div />}
          {hr.cons?.length ? (
            <div class="pick-cons">
              <h4>Waar we op letten</h4>
              <ul>{hr.cons.map(con => <li>{con}</li>)}</ul>
            </div>
          ) : <div />}
        </div>
      </section>
    )}

    {post.expertReviewer && (
      <section class="guide-section" id="expert">
        <h2>Expertblik</h2>
        <p>
          <strong>{post.expertReviewer.name}</strong>
          {post.expertReviewer.title ? ` · ${post.expertReviewer.title}` : ''}
        </p>
        {post.expertReviewer.quote && (
          <p class="hr-expert-quote">“{post.expertReviewer.quote}”</p>
        )}
      </section>
    )}

    {hr?.relatedComparison && (
      <aside class="hr-related" aria-label="Gerelateerde vergelijking">
        <div class="hr-related-label">Vergelijking</div>
        <p>
          Meer merken naast dit product?
          <a href={hr.relatedComparison.href}>{hr.relatedComparison.title}</a>
        </p>
      </aside>
    )}

    <section class="pick" id="eindoordeel">
      <span class="pick-label" data-kind="top">Eindoordeel</span>
      <h2 class="pick-h2">{productName}</h2>
      {hr?.overallScore != null && (
        <p class="pick-summary">
          Score {hr.overallScore}/10{hr.testPeriod ? ` · ${hr.testPeriod} getest` : ''}.
        </p>
      )}
      <div style="max-width:360px">
        <PickBuy
          offers={offers}
          limit={2}
          emptyHint="Prijs/link volgt zodra affiliate-feed gekoppeld is."
        />
      </div>
    </section>

    {post.faq && post.faq.length > 0 && (
      <div class="guide-faq" id="veelgestelde-vragen">
        <h2>Veelgestelde vragen</h2>
        {post.faq.map(item => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    )}

    {post.author && <AuthorBox author={post.author} variant="full" />}
  </article>
</BaseLayout>
