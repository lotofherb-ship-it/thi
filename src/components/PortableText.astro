---
/**
 * Simple Portable Text renderer for THI article body.
 * Handles: paragraphs, headings, lists, blockquotes, images, tables.
 * WP-migrated soft breaks (\n spans) are normalized into real <p> blocks.
 * Migrated inline buy stacks (name + Vanaf € + Bekijk prijs + disclosure)
 * coalesce into mini PickBuy-style cards, with a render-time density policy:
 * same product/URL → at most 2 full cards (early + end); soft cap ≤3 cards/article;
 * later repeats → quiet text affiliate link (or omit when adjacent noise).
 */
import type { PortableTextBlock } from '@portabletext/types';
import { urlFor } from '../lib/sanity';
import {
  merchantDisplayName,
  offerCta,
  PICK_DISC_SHORT,
  type ProductOffer,
} from '../lib/products/resolve';

export interface Props {
  value: PortableTextBlock[];
  class?: string;
  /** Prefer resolved commerce for detected inline buy stacks (e.g. PLNKT). */
  defaultOffer?: ProductOffer | null;
}

const { value, class: className = '', defaultOffer = null } = Astro.props;

/** Escape HTML special characters to prevent XSS. */
function escapeHtml(str: string): string {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

/** Validate a href — only allow http(s), relative, and anchor links. */
function safeHref(href: string): string {
  if (!href) return '#';
  return /^(https?:\/\/|\/|#)/.test(href) ? href : '#';
}

/** Sanity soft-break / blank span left by WP migration. */
function isSoftBreak(child: any): boolean {
  if (!child || (child._type && child._type !== 'span')) return false;
  const text = child.text ?? '';
  return typeof text === 'string' && text.includes('\n') && text.trim() === '';
}

/** Render one inline span (marks + link), without soft-break handling. */
function renderSpan(child: any, block: any): string {
  let text = escapeHtml(child.text || '');
  // Newlines inside a longer span → soft break within the same paragraph
  text = text.replace(/\n+/g, '<br />');

  if (child.marks?.includes('strong')) text = `<strong>${text}</strong>`;
  if (child.marks?.includes('em')) text = `<em>${text}</em>`;
  if (child.marks?.includes('code')) text = `<code>${text}</code>`;

  const markKey = child.marks?.find((m: string) =>
    block.markDefs?.some((d: any) => d._key === m)
  );
  if (markKey) {
    const markDef = block.markDefs?.find((d: any) => d._key === markKey);
    if (markDef?._type === 'link') {
      const href = safeHref(markDef.href);
      const isExternal = /^https?:\/\//.test(href);
      const rel = isExternal ? ' rel="noopener noreferrer"' : '';
      const target = (markDef.blank || isExternal) ? ' target="_blank"' : '';
      text = `<a href="${escapeHtml(href)}"${target}${rel}>${text}</a>`;
    }
  }
  return text;
}

/**
 * Build inline HTML for a block, splitting WP soft-break spans into
 * separate paragraph strings so CSS margin can apply.
 */
function paragraphChunks(block: any): string[] {
  const children = block.children || [];
  const chunks: string[] = [];
  let current = '';

  const flush = () => {
    const html = current.replace(/(?:<br\s*\/?>\s*)+$/g, '').trim();
    if (html) chunks.push(html);
    current = '';
  };

  for (const child of children) {
    if (isSoftBreak(child)) {
      flush();
      continue;
    }
    current += renderSpan(child, block);
  }
  flush();
  return chunks;
}

function getText(block: any): string {
  return paragraphChunks(block).join(' ');
}

function plainText(block: any): string {
  return (block?.children || []).map((c: any) => c.text || '').join('').trim();
}

function blockLinkHref(block: any): string | null {
  const def = (block.markDefs || []).find((d: any) => d._type === 'link' && d.href);
  return def ? safeHref(def.href) : null;
}

function isNormalPara(block: any): boolean {
  return (
    block?._type === 'block' &&
    (!block.style || block.style === 'normal') &&
    !block.listItem
  );
}

/** Migrated WP product CTA: name / Vanaf €… / Bekijk prijs… / Directe link… */
function matchInlineBuyStack(blocks: any[], start: number): number {
  if (start + 2 >= blocks.length) return 0;
  const a = blocks[start];
  const b = blocks[start + 1];
  const c = blocks[start + 2];
  if (!isNormalPara(a) || !isNormalPara(b) || !isNormalPara(c)) return 0;

  const name = plainText(a);
  const priceLine = plainText(b);
  const ctaLine = plainText(c);
  if (!name || name.length > 90) return 0;
  if (!/^Vanaf\s*€/i.test(priceLine)) return 0;
  if (!/Bekijk\s+prijs/i.test(ctaLine) || !blockLinkHref(c)) return 0;

  let consumed = 3;
  const d = blocks[start + 3];
  if (d && isNormalPara(d) && /Directe link|officieel affiliate|Partnerlink/i.test(plainText(d))) {
    consumed = 4;
  }
  return consumed;
}

function priceFromVanaf(line: string): string {
  const m = line.match(/€\s*[\d.,]+/);
  return m ? m[0].replace(/\s+/g, '') : '';
}

function merchantFromCta(cta: string): string {
  const m = cta.match(/Bekijk\s+prijs\s+bij\s+(.+?)(?:\s*→)?$/i);
  if (m) return m[1].replace(/→/g, '').trim();
  return 'webshop';
}

/** Soft caps — keep body readable; ATF/end PickBuy modules are separate. */
const MAX_FULL_CARDS_PER_KEY = 2;
const MAX_FULL_CARDS_TOTAL = 3;

type InlineBuyHit = {
  start: number;
  count: number;
  name: string;
  href: string;
  key: string;
  offer: ProductOffer;
  migratedPrice: string;
};

type InlineBuyMode = 'card' | 'link' | 'omit';

function resolveInlineOffer(
  name: string,
  hrefFromBody: string,
  migratedPrice: string,
  migratedMerchant: string,
): ProductOffer {
  const useDefault =
    defaultOffer &&
    (!hrefFromBody ||
      hrefFromBody === '#' ||
      hrefFromBody === defaultOffer.url ||
      /tidd\.ly|plnkt/i.test(hrefFromBody) ||
      /plnkt/i.test(name));

  if (useDefault && defaultOffer) return defaultOffer;
  return {
    merchant: migratedMerchant,
    price: migratedPrice,
    url: hrefFromBody,
    source: 'manual',
  };
}

/** Stable identity for dedupe: prefer offer URL, else name+merchant. */
function inlineBuyKey(name: string, offer: ProductOffer, hrefFromBody: string): string {
  const url = (offer.url || hrefFromBody || '').trim().toLowerCase();
  if (url && url !== '#') {
    try {
      const u = new URL(url);
      // Drop tracking noise; keep path so distinct SKUs stay distinct.
      return `url:${u.origin}${u.pathname}`.replace(/\/$/, '');
    } catch {
      return `url:${url.split('?')[0]}`;
    }
  }
  const shop = merchantDisplayName(offer.merchant || '').toLowerCase();
  return `name:${name.toLowerCase().replace(/\s+/g, ' ').trim()}|${shop}`;
}

function collectInlineBuyHits(blocks: any[]): InlineBuyHit[] {
  const hits: InlineBuyHit[] = [];
  let i = 0;
  while (i < blocks.length) {
    const count = matchInlineBuyStack(blocks, i);
    if (!count) {
      i++;
      continue;
    }
    const name = plainText(blocks[i]);
    const priceLine = plainText(blocks[i + 1]);
    const ctaBlock = blocks[i + 2];
    const hrefFromBody = blockLinkHref(ctaBlock) || '#';
    const migratedPrice = priceFromVanaf(priceLine);
    const migratedMerchant = merchantFromCta(plainText(ctaBlock));
    const offer = resolveInlineOffer(name, hrefFromBody, migratedPrice, migratedMerchant);
    hits.push({
      start: i,
      count,
      name,
      href: hrefFromBody,
      key: inlineBuyKey(name, offer, hrefFromBody),
      offer,
      migratedPrice,
    });
    i += count;
  }
  return hits;
}

/**
 * Density plan:
 * - Per product/URL: full card at first + last mention (max 2).
 * - Soft cap ≤3 full cards/article (different products still eligible).
 * - Other same-product hits → quiet text link; omit when adjacent noise.
 */
function planInlineBuyModes(hits: InlineBuyHit[]): Map<number, InlineBuyMode> {
  const modes = new Map<number, InlineBuyMode>();
  if (!hits.length) return modes;

  const byKey = new Map<string, InlineBuyHit[]>();
  for (const hit of hits) {
    const list = byKey.get(hit.key) || [];
    list.push(hit);
    byKey.set(hit.key, list);
  }

  // Candidate card slots: first + last per key (deduped when only one).
  const candidates: InlineBuyHit[] = [];
  for (const list of byKey.values()) {
    candidates.push(list[0]);
    if (list.length > 1) candidates.push(list[list.length - 1]);
  }
  // Document order for soft-cap decisions.
  candidates.sort((a, b) => a.start - b.start);

  const kept = new Set<number>();
  if (candidates.length <= MAX_FULL_CARDS_TOTAL) {
    for (const c of candidates) kept.add(c.start);
  } else {
    // Keep earliest first-mentions and latest end-CTAs without exceeding per-key/total caps.
    const firsts = [...byKey.values()].map(list => list[0]).sort((a, b) => a.start - b.start);
    const lasts = [...byKey.values()]
      .map(list => (list.length > 1 ? list[list.length - 1] : null))
      .filter((h): h is InlineBuyHit => !!h)
      .sort((a, b) => b.start - a.start);

    const perKey = new Map<string, number>();
    const tryKeep = (hit: InlineBuyHit) => {
      if (kept.size >= MAX_FULL_CARDS_TOTAL || kept.has(hit.start)) return;
      const n = perKey.get(hit.key) || 0;
      if (n >= MAX_FULL_CARDS_PER_KEY) return;
      kept.add(hit.start);
      perKey.set(hit.key, n + 1);
    };

    // Early converter first, then end CTAs (strong primary + close).
    for (const h of firsts) tryKeep(h);
    for (const h of lasts) tryKeep(h);
  }

  for (let i = 0; i < hits.length; i++) {
    const hit = hits[i];
    if (kept.has(hit.start)) {
      modes.set(hit.start, 'card');
      continue;
    }
    const prev = hits[i - 1];
    const adjacentSame =
      prev &&
      prev.key === hit.key &&
      prev.start + prev.count === hit.start;
    modes.set(hit.start, adjacentSame ? 'omit' : 'link');
  }
  return modes;
}

function renderInlineBuyCard(hit: InlineBuyHit): string {
  const { action, price } = offerCta(hit.offer, 'primary');
  const shop = merchantDisplayName(hit.offer.merchant);
  const displayPrice = price || hit.migratedPrice;
  const safeUrl = escapeHtml(safeHref(hit.offer.url));

  return `
    <aside class="inline-buy" aria-label="Koop ${escapeHtml(hit.name)}">
      <div class="inline-buy-name">${escapeHtml(hit.name)}</div>
      <a
        class="inline-buy-cta"
        href="${safeUrl}"
        target="_blank"
        rel="noopener noreferrer nofollow sponsored"
      >
        <span class="inline-buy-action">${escapeHtml(action || `Bekijk bij ${shop}`)}</span>
        ${displayPrice ? `<span class="inline-buy-meta">${escapeHtml(displayPrice)}</span>` : ''}
      </a>
      <p class="inline-buy-disc">${escapeHtml(PICK_DISC_SHORT)} <a href="/affiliate-disclosure/">Meer info</a></p>
    </aside>
  `;
}

/** Quiet in-flow affiliate mention — not another mini-card. */
function renderInlineBuyLink(hit: InlineBuyHit): string {
  const shop = merchantDisplayName(hit.offer.merchant);
  const label = `Bekijk prijs bij ${shop}`;
  const safeUrl = escapeHtml(safeHref(hit.offer.url));
  return `
    <p class="inline-buy-text">
      <a
        href="${safeUrl}"
        target="_blank"
        rel="noopener noreferrer nofollow sponsored"
      >${escapeHtml(label)} →</a>
    </p>
  `;
}

function renderInlineBuy(hit: InlineBuyHit, mode: InlineBuyMode): string {
  if (mode === 'omit') return '';
  if (mode === 'link') return renderInlineBuyLink(hit);
  return renderInlineBuyCard(hit);
}

function renderBlock(block: any): string {
  switch (block._type) {
    case 'block': {
      switch (block.style) {
        case 'h2': {
          const text = getText(block);
          return text ? `<h2 class="entry-h2" id="${slugify(text)}">${text}</h2>` : '';
        }
        case 'h3': {
          const text = getText(block);
          return text ? `<h3 class="entry-h3">${text}</h3>` : '';
        }
        case 'h4': {
          const text = getText(block);
          return text ? `<h4 class="entry-h4">${text}</h4>` : '';
        }
        case 'blockquote': {
          const parts = paragraphChunks(block);
          if (!parts.length) return '';
          return `<blockquote class="entry-blockquote">${parts.map(p => `<p>${p}</p>`).join('')}</blockquote>`;
        }
        default: {
          const parts = paragraphChunks(block);
          return parts.map(p => `<p class="entry-p">${p}</p>`).join('');
        }
      }
    }

    case 'image': {
      if (!block.asset) return '';
      // Contain-friendly: no forced landscape crop on editorial figures
      const src = urlFor(block).width(760).fit('max').auto('format').url();
      const alt = escapeHtml(block.alt || '');
      const caption = block.caption ? escapeHtml(block.caption) : '';
      return `
        <figure class="entry-figure">
          <img src="${escapeHtml(src)}" alt="${alt}" loading="lazy" decoding="async" />
          ${caption ? `<figcaption class="entry-caption">${caption}</figcaption>` : ''}
        </figure>
      `;
    }

    case 'table': {
      if (!block.rows?.length) return '';
      const [header, ...rows] = block.rows;
      const ths = header.cells.map((c: string) => `<th>${escapeHtml(c)}</th>`).join('');
      const trs = rows.map((r: any) =>
        `<tr>${r.cells.map((c: string) => `<td>${escapeHtml(c)}</td>`).join('')}</tr>`
      ).join('');
      return `
        <div class="table-wrap">
          <table class="entry-table">
            <thead><tr>${ths}</tr></thead>
            <tbody>${trs}</tbody>
          </table>
        </div>
      `;
    }

    default:
      return '';
  }
}

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/<[^>]*>/g, '')
    .replace(/[^a-z0-9\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-');
}

// Group list items + coalesce migrated inline buy stacks (density-aware)
function renderBlocks(blocks: any[]): string {
  const buyHits = collectInlineBuyHits(blocks);
  const buyModes = planInlineBuyModes(buyHits);
  const buyByStart = new Map(buyHits.map(h => [h.start, h]));

  let html = '';
  let i = 0;

  while (i < blocks.length) {
    const block = blocks[i];
    const hit = buyByStart.get(i);

    if (hit) {
      const mode = buyModes.get(hit.start) || 'card';
      html += renderInlineBuy(hit, mode);
      i += hit.count;
      continue;
    }

    if (block._type === 'block' && (block.listItem === 'bullet' || block.listItem === 'number')) {
      const tag = block.listItem === 'bullet' ? 'ul' : 'ol';
      const items: string[] = [];
      const level = block.level || 1;

      while (
        i < blocks.length &&
        blocks[i]._type === 'block' &&
        blocks[i].listItem === block.listItem &&
        (blocks[i].level || 1) === level
      ) {
        const itemHtml = paragraphChunks(blocks[i]).join('<br />') || getText(blocks[i]);
        items.push(`<li>${itemHtml}</li>`);
        i++;
      }

      html += `<${tag} class="entry-list">${items.join('')}</${tag}>`;
      continue;
    }

    html += renderBlock(block);
    i++;
  }

  return html;
}

const html = renderBlocks(value || []);
---

<div class:list={['entry-content', className]} set:html={html} />

{/* :global — set:html nodes do not receive Astro scoped attrs */}
<style is:global>
  .entry-content .entry-figure {
    margin: 28px 0;
    max-width: var(--col-max, 640px);
  }
  .entry-content .entry-figure img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 520px;
    object-fit: contain;
    object-position: center;
    background: var(--cream-2);
    border: 1px solid var(--cream-3);
    border-radius: 10px;
  }
  .entry-content .entry-caption {
    font: 400 12.5px/1.45 var(--font-body);
    color: var(--muted);
    margin-top: 8px;
    text-align: center;
  }
  .entry-content .table-wrap {
    overflow-x: auto;
    margin-bottom: 28px;
  }
  .entry-content .entry-list {
    padding-left: 1.25em;
    margin: 0 0 1.15em;
  }
  .entry-content .entry-list li {
    font: 400 15px/1.55 var(--font-body);
    color: var(--body);
    margin: 0 0 0.55em;
  }
  .entry-content .entry-list li:last-child {
    margin-bottom: 0;
  }
  .entry-content .entry-h4 {
    font: 700 16px/1.3 var(--font-head);
    color: var(--text);
    margin: 20px 0 8px;
  }

  /* Mini PickBuy — migrated inline product stacks (density-capped) */
  .entry-content .inline-buy {
    margin: 22px 0 26px;
    padding: 14px 16px;
    max-width: 22rem;
    background: var(--cream-2, #f3f0e8);
    border: 1px solid var(--cream-3, #e4dfd2);
    border-radius: 10px;
  }
  /* Subsequent same-product mentions — quiet text, not another card */
  .entry-content .inline-buy-text {
    margin: 0 0 1.15em;
    font: 400 15px/1.55 var(--font-body, inherit);
    color: var(--body, #2a2a2a);
  }
  .entry-content .inline-buy-text a {
    color: var(--green-900, #1f3d2a);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .entry-content .inline-buy-text a:hover {
    color: var(--green-700, #3d5c47);
  }
  .entry-content .inline-buy-name {
    font: 700 15px/1.3 var(--font-head, inherit);
    color: var(--text, #1a1a1a);
    letter-spacing: -.01em;
    margin: 0 0 10px;
  }
  .entry-content .inline-buy-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    padding: 11px 14px;
    min-height: 48px;
    background: var(--celery, #d9f99d);
    border: 1px solid var(--celery-d, #b8e06a);
    border-radius: 8px;
    text-decoration: none !important;
    color: var(--green-900, #1f3d2a);
  }
  .entry-content .inline-buy-cta:hover { filter: brightness(.97); }
  .entry-content .inline-buy-action {
    font: 700 14.5px/1.2 var(--font-head, inherit);
    letter-spacing: -.01em;
  }
  .entry-content .inline-buy-meta {
    font: 600 12px/1.25 var(--font-body, inherit);
    color: var(--green-700, #3d5c47);
  }
  .entry-content .inline-buy-disc {
    font: 400 11px/1.4 var(--font-body, inherit);
    color: var(--muted, #6b7280);
    margin: 8px 0 0;
  }
  .entry-content .inline-buy-disc a {
    color: var(--green-900, #1f3d2a);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  @media (max-width: 640px) {
    .entry-content .inline-buy { max-width: none; }
    .entry-content .inline-buy-cta {
      width: 100%;
      align-items: center;
      text-align: center;
      min-height: 52px;
    }
  }
</style>
