---
const currentPath = Astro.url.pathname;

/** Klusjes-first nav — money hubs in primary; voeding/recepten demoted. */
const navLinks = [
  { href: '/supplementen/', label: 'Supplementen' },
  { href: '/training/',     label: 'Training' },
  { href: '/gezondheid/',   label: 'Gezondheid' },
  { href: '/vergelijken/',  label: 'Vergelijken' },
  { href: '/reviews/',      label: 'Reviews' },
];

const drawerExtras = [
  { href: '/voeding/',             label: 'Voeding' },
  { href: '/voeding/calculators/', label: 'Rekentools' },
  { href: '/methode/',             label: 'Methode' },
];
---

<nav class="thi-nav" aria-label="Hoofdnavigatie">
  <div class="thi-nav-inner">
    <a href="/" class="thi-logo" aria-label="The Health Issue home">
      <span class="thi-logo-mark">The Health Issue</span>
      <span class="thi-logo-dot" aria-hidden="true"></span>
    </a>

    <div class="thi-nav-links" role="list">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          role="listitem"
          class:list={[{ active: currentPath === href || currentPath.startsWith(href) }]}
        >
          {label}
        </a>
      ))}
    </div>

    <div class="thi-nav-actions">
      <a href="/nieuwsbrief/" class="thi-nav-cta">Nieuwsbrief</a>
    </div>

    <button
      class="thi-nav-hamburger"
      type="button"
      aria-label="Menu openen"
      aria-expanded="false"
      aria-controls="mobile-drawer"
      id="mobile-menu-btn"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<div class="thi-drawer" id="mobile-drawer" aria-hidden="true" hidden>
  <div class="thi-drawer-inner" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="thi-drawer-header">
      <a href="/" class="thi-logo">
        <span class="thi-logo-mark">The Health Issue</span>
        <span class="thi-logo-dot" aria-hidden="true"></span>
      </a>
      <button class="thi-drawer-close" type="button" id="mobile-drawer-close" aria-label="Menu sluiten">✕</button>
    </div>
    <nav class="thi-drawer-links" aria-label="Categorieën">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class:list={['thi-drawer-link', { active: currentPath === href || currentPath.startsWith(href) }]}
        >
          {label}
        </a>
      ))}
    </nav>
    <nav class="thi-drawer-secondary" aria-label="Meer">
      {drawerExtras.map(({ href, label }) => (
        <a
          href={href}
          class:list={['thi-drawer-link thi-drawer-link--sec', { active: currentPath === href || currentPath.startsWith(href) }]}
        >
          {label}
        </a>
      ))}
    </nav>
    <div class="thi-drawer-foot">
      <a href="/nieuwsbrief/" class="thi-drawer-cta">Nieuwsbrief</a>
    </div>
  </div>
</div>

<style is:global>
  /* ── Site chrome: nav + optional WC browse balk as one sticky stack ── */
  .thi-chrome {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--white);
  }
  .thi-chrome:has(.guide-toc) {
    background: var(--white);
  }

  .thi-nav {
    background: var(--white);
    border-bottom: 1px solid var(--cream-3);
    height: var(--nav-h);
  }
  .thi-nav-inner {
    max-width: var(--site-wide);
    margin: 0 auto;
    padding: 0 var(--site-gutter);
    height: 100%;
    display: flex;
    align-items: center;
    gap: 28px;
  }

  /* Wordmark — hero-level in chrome */
  .thi-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .thi-logo-mark {
    font: 700 clamp(17px, 2.4vw, 20px)/1 var(--font-head);
    letter-spacing: -.03em;
    color: var(--green-900);
  }
  .thi-logo-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--celery);
    display: inline-block;
    flex-shrink: 0;
  }

  /* Categories sit with the wordmark — not orphaned far-right */
  .thi-nav-links {
    display: flex;
    align-items: center;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }
  .thi-nav-links a {
    font: 700 14.5px/1 var(--font-body);
    color: var(--green-900) !important;
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 4px;
    letter-spacing: -.012em;
    transition: background .12s ease, opacity .12s ease;
  }
  .thi-nav-links a:hover {
    background: var(--cream-2);
  }
  .thi-nav-links a.active {
    box-shadow: inset 0 -2px 0 var(--celery-d);
    border-radius: 0;
    background: transparent;
  }

  .thi-nav-actions {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    margin-left: auto;
  }
  .thi-nav-cta {
    background: var(--green-900);
    color: var(--celery);
    font: 700 13px/1 var(--font-head);
    letter-spacing: -.01em;
    padding: 10px 18px;
    border-radius: var(--r-sm);
    text-decoration: none;
    flex-shrink: 0;
    transition: background .12s ease;
  }
  .thi-nav-cta:hover { background: var(--green-700); }

  .thi-nav-hamburger {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    margin-left: auto;
    flex-shrink: 0;
    border-radius: 4px;
  }
  .thi-nav-hamburger:hover { background: var(--cream-2); }
  .thi-nav-hamburger span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--green-900);
    border-radius: 1px;
  }

  /* Mobile drawer */
  .thi-drawer {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(20, 20, 19, .4);
  }
  .thi-drawer-inner {
    position: absolute;
    top: 0;
    right: 0;
    width: min(320px, 90vw);
    height: 100%;
    background: var(--cream);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    box-shadow: -8px 0 32px rgba(28, 58, 19, .12);
  }
  .thi-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 20px;
    background: var(--white);
    border-bottom: 1px solid var(--cream-3);
  }
  .thi-drawer-close {
    background: none;
    border: none;
    font-size: 18px;
    line-height: 1;
    color: var(--body);
    cursor: pointer;
    padding: 8px 10px;
    border-radius: 4px;
  }
  .thi-drawer-close:hover { background: var(--cream-2); color: var(--text); }
  .thi-drawer-links {
    display: flex;
    flex-direction: column;
    padding: 12px 0 4px;
    background: var(--white);
  }
  .thi-drawer-secondary {
    display: flex;
    flex-direction: column;
    padding: 4px 0 8px;
    border-top: 1px solid var(--cream-3);
    background: var(--cream);
  }
  .thi-drawer-link {
    padding: 14px 20px;
    font: 700 16px/1.2 var(--font-body);
    color: var(--text);
    text-decoration: none;
  }
  .thi-drawer-link:hover,
  .thi-drawer-link.active { background: var(--cream-2); color: var(--green-900); }
  .thi-drawer-link--sec {
    font-weight: 400;
    font-size: 14.5px;
    color: var(--body);
  }
  .thi-drawer-foot {
    margin-top: auto;
    padding: 20px;
    background: var(--white);
    border-top: 1px solid var(--cream-3);
  }
  .thi-drawer-cta {
    display: block;
    text-align: center;
    background: var(--green-900);
    color: var(--celery);
    font: 700 15px/1 var(--font-head);
    padding: 14px 18px;
    border-radius: var(--r-sm);
    text-decoration: none;
  }
  .thi-drawer-cta:hover { background: var(--green-700); }

  body.nav-open { overflow: hidden; }

  @media (max-width: 900px) {
    .thi-nav-inner { gap: 12px; }
    .thi-nav .thi-nav-links,
    .thi-nav .thi-nav-actions { display: none !important; }
    .thi-nav .thi-nav-hamburger { display: flex !important; }
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-drawer');
  const closeBtn = document.getElementById('mobile-drawer-close');

  function openDrawer() {
    if (!drawer) return;
    drawer.hidden = false;
    drawer.setAttribute('aria-hidden', 'false');
    btn?.setAttribute('aria-expanded', 'true');
    document.body.classList.add('nav-open');
    closeBtn?.focus();
  }
  function closeDrawer() {
    if (!drawer) return;
    drawer.hidden = true;
    drawer.setAttribute('aria-hidden', 'true');
    btn?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('nav-open');
    btn?.focus();
  }

  btn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  drawer?.addEventListener('click', (e) => { if (e.target === drawer) closeDrawer(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDrawer(); });
</script>
