---
/**
 * Artikelagent — content-grounded chips companion (ChatGPT/Claude canvas).
 * Chrome: ColorsWall blue #1987ff + greyscale.
 * Buy CTAs: THI celery primary (.thi-cta--primary).
 * Chips-only v1 · no live LLM.
 */
import type { ArtikelagentRuntime } from '../lib/artikelagent';

interface Props {
  runtime: ArtikelagentRuntime;
}

const { runtime } = Astro.props;
const runtimeJson = JSON.stringify(runtime);
const authorInitial = (runtime.authorName || 'J').trim().charAt(0).toUpperCase() || 'J';
---

<aside
  class="aa"
  id="artikelagent"
  data-aa-root
  data-aa={runtimeJson}
  role="region"
  aria-label="Artikelagent"
>
  <header class="aa-top">
    <div class="aa-av" aria-hidden="true">{authorInitial}</div>
    <div class="aa-id">
      <p class="aa-title">Artikelagent</p>
      <p class="aa-sub">{runtime.authorName} · The Health Issue</p>
    </div>
    <span class="aa-badge">In dit artikel</span>
  </header>

  <div class="aa-canvas" data-aa-canvas aria-live="polite">
    <div class="aa-msg" data-aa-seed>
      <div class="aa-mini" aria-hidden="true">{authorInitial}</div>
      <div class="aa-bubble aa-bubble--a">
        <span data-aa-seed-text>{runtime.seed}</span>
        {runtime.seedSignedBy === 'jouke' ? (
          <span class="aa-sign">{runtime.authorName}</span>
        ) : null}
      </div>
    </div>
  </div>

  <div class="aa-chrome">
    <p class="aa-disc">{runtime.disclosure}</p>
    <div class="aa-chips" data-aa-chips role="group" aria-label="Kies een vraag">
      {runtime.openingChips.map(chip => (
        <button
          type="button"
          class:list={['aa-chip', { 'aa-chip--decide': chip.intentClass === 'decide' }]}
          data-aa-chip={chip.id}
          data-intent={chip.intentClass || ''}
          data-analytics-key={chip.analyticsKey || chip.id}
        >
          {chip.label}
        </button>
      ))}
    </div>
    <div class="aa-composer" aria-hidden="true">
      <span>Stel een vraag…</span>
      <span class="aa-lock">alleen chips</span>
    </div>
  </div>
</aside>

<style is:global>
  .aa {
    --aa-blue: #1987ff;
    --aa-blue-soft: #e6f2ff;
    --aa-blue-chip-border: #99caff;
    --aa-canvas: #f2f2f7;
    --aa-bg: #ffffff;
    --aa-border: #e5e5ea;
    --aa-muted: #8e8e93;
    --aa-ink: #1c1c1e;
    --aa-av: #3a3a3c;
    --aa-av-ink: #f2f2f7;

    margin: 0 0 28px;
    background: var(--aa-bg);
    border: 1px solid var(--aa-border);
    border-radius: 16px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 12px 32px rgba(0, 0, 0, 0.06);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    color: var(--aa-ink);
    width: 100%;
  }

  .aa-top {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--aa-border);
    background: var(--aa-bg);
  }

  .aa-av {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--aa-av);
    color: var(--aa-av-ink);
    display: grid;
    place-items: center;
    font: 700 13px/1 var(--font-head);
    flex-shrink: 0;
  }

  .aa-id {
    min-width: 0;
  }

  .aa-title {
    margin: 0;
    font: 700 14px/1.2 var(--font-head);
    color: var(--aa-ink);
  }

  .aa-sub {
    margin: 2px 0 0;
    font: 400 12px/1.3 var(--font-body);
    color: var(--aa-muted);
  }

  .aa-badge {
    margin-left: auto;
    font: 600 11px/1.2 var(--font-body);
    color: var(--aa-muted);
    border: 1px solid var(--aa-border);
    border-radius: 999px;
    padding: 4px 8px;
    background: var(--aa-canvas);
    white-space: nowrap;
  }

  .aa-canvas {
    flex: 1;
    background: var(--aa-canvas);
    padding: 18px 16px 12px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 140px;
    max-height: min(62vh, 560px);
    overflow-y: auto;
  }

  .aa-msg {
    display: flex;
    gap: 10px;
    max-width: 94%;
  }

  .aa-msg--user {
    align-self: flex-end;
    flex-direction: row-reverse;
  }

  .aa-mini {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 2px;
    background: var(--aa-av);
    color: var(--aa-av-ink);
    display: grid;
    place-items: center;
    font: 700 10px/1 var(--font-head);
  }

  .aa-msg--user .aa-mini {
    background: #d1d1d6;
    color: var(--aa-ink);
    font-size: 9px;
  }

  .aa-bubble {
    padding: 12px 14px;
    border-radius: 18px;
    font: 400 14.5px/1.5 var(--font-body);
  }

  .aa-bubble--a {
    background: #fff;
    border: 1px solid var(--aa-border);
    border-bottom-left-radius: 5px;
    color: var(--aa-ink);
  }

  .aa-bubble--u {
    background: var(--aa-blue);
    color: #fff;
    font-weight: 600;
    border-bottom-right-radius: 5px;
  }

  .aa-sign {
    display: block;
    margin-top: 8px;
    font: 600 11.5px/1.2 var(--font-body);
    color: #636366;
  }

  .aa-claim {
    display: inline-block;
    margin-top: 6px;
    font: 600 10px/1.2 var(--font-body);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--aa-muted);
  }

  .aa-typing {
    display: inline-flex;
    gap: 5px;
    padding: 14px 16px;
    border-radius: 18px;
    background: #fff;
    border: 1px solid var(--aa-border);
  }

  .aa-typing i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--aa-muted);
    opacity: 0.7;
    display: block;
    animation: aa-dot 1.2s ease-in-out infinite;
  }

  .aa-typing i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .aa-typing i:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes aa-dot {
    0%,
    80%,
    100% {
      opacity: 0.35;
      transform: translateY(0);
    }
    40% {
      opacity: 1;
      transform: translateY(-2px);
    }
  }

  .aa-cite {
    display: inline-block;
    margin-left: 34px;
    font: 400 11.5px/1.3 var(--font-body);
    color: var(--aa-muted);
    background: #e5e5ea;
    border-radius: 6px;
    padding: 4px 8px;
  }

  .aa-proof {
    display: inline-flex;
    margin-left: 34px;
    font: 600 13px/1.3 var(--font-body);
    color: var(--aa-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .aa-proof:hover {
    color: #0066d6;
  }

  .aa-outcome {
    margin-left: 34px;
    max-width: 420px;
    background: var(--aa-bg);
    border: 1px solid var(--aa-border);
    border-radius: 12px;
    padding: 12px 14px;
  }

  .aa-outcome-k {
    margin: 0 0 4px;
    font: 700 10.5px/1.2 var(--font-body);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--aa-muted);
  }

  .aa-outcome-n {
    margin: 0 0 4px;
    font: 700 15px/1.25 var(--font-body);
    color: var(--aa-ink);
  }

  .aa-outcome-c,
  .aa-outcome-tr {
    margin: 0 0 4px;
    font: 400 13px/1.4 var(--font-body);
    color: #636366;
  }

  .aa-outcome-tr {
    margin-bottom: 10px;
    font-size: 12.5px;
    color: var(--aa-muted);
  }

  .aa-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .aa-buy {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    min-height: 44px;
    text-decoration: none;
  }

  .aa-chrome {
    border-top: 1px solid var(--aa-border);
    background: var(--aa-bg);
    padding: 12px 14px 14px;
  }

  .aa-disc {
    margin: 0 0 10px;
    font: 400 11.5px/1.4 var(--font-body);
    color: var(--aa-muted);
  }

  .aa-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .aa-chip {
    appearance: none;
    border: 1px solid #d1d1d6;
    background: #fff;
    color: var(--aa-ink);
    font: 600 13px/1.3 var(--font-body);
    padding: 10px 12px;
    min-height: 40px;
    border-radius: 999px;
    cursor: pointer;
  }

  .aa-chip:hover {
    border-color: var(--aa-blue);
    color: var(--aa-blue);
  }

  .aa-chip--decide {
    border-color: var(--aa-blue-chip-border);
    background: var(--aa-blue-soft);
    color: var(--aa-blue);
  }

  .aa-chip:focus-visible {
    outline: 2px solid var(--aa-blue);
    outline-offset: 2px;
  }

  .aa-chip:disabled {
    opacity: 0.45;
    cursor: default;
  }

  .aa-composer {
    margin-top: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--aa-border);
    border-radius: 14px;
    padding: 10px 12px;
    background: var(--aa-canvas);
    color: var(--aa-muted);
    font: 400 13px/1.3 var(--font-body);
    pointer-events: none;
    user-select: none;
  }

  .aa-lock {
    margin-left: auto;
    font-size: 11px;
    border: 1px solid var(--aa-border);
    border-radius: 999px;
    padding: 3px 8px;
    background: #fff;
    color: #636366;
  }

  @media (max-width: 640px) {
    .aa-badge {
      display: none;
    }
    .aa-outcome {
      margin-left: 0;
      max-width: 100%;
    }
    .aa-cite,
    .aa-proof {
      margin-left: 0;
    }
    .aa-buy {
      width: 100%;
    }
  }
</style>

<script>
  function initArtikelagent(root) {
    const raw = root.dataset.aa;
    if (!raw) return;
    const data = JSON.parse(raw);
    const canvas = root.querySelector('[data-aa-canvas]');
    const chipsEl = root.querySelector('[data-aa-chips]');
    const authorInitial = (data.authorName || 'J').trim().charAt(0).toUpperCase() || 'J';

    function track(event, payload) {
      const detail = Object.assign({ event: event, scriptId: data.id }, payload || {});
      window.dispatchEvent(new CustomEvent('thi:artikelagent', { detail: detail }));
      if (window.dataLayer && typeof window.dataLayer.push === 'function') {
        window.dataLayer.push(Object.assign({ event: 'thi_aa_' + event }, detail));
      }
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'thi_aa_' + event, detail);
      }
    }

    track('view', {});

    function el(tag, className, text) {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text != null) node.textContent = text;
      return node;
    }

    function appendUser(label) {
      const row = el('div', 'aa-msg aa-msg--user');
      const mini = el('div', 'aa-mini', 'Jij');
      mini.setAttribute('aria-hidden', 'true');
      const bubble = el('div', 'aa-bubble aa-bubble--u', label);
      row.appendChild(mini);
      row.appendChild(bubble);
      canvas.appendChild(row);
    }

    function appendTyping() {
      const row = el('div', 'aa-msg');
      row.dataset.aaTyping = '1';
      const mini = el('div', 'aa-mini', authorInitial);
      mini.setAttribute('aria-hidden', 'true');
      const dots = el('div', 'aa-typing');
      dots.setAttribute('aria-label', 'Bezig met antwoorden');
      dots.innerHTML = '<i></i><i></i><i></i>';
      row.appendChild(mini);
      row.appendChild(dots);
      canvas.appendChild(row);
      return row;
    }

    function claimLabel(mode) {
      if (mode === 'opinion') return 'Redactioneel oordeel';
      if (mode === 'authorized') return 'EU-claim';
      if (mode === 'refuse') return 'Geen medisch advies';
      return '';
    }

    function appendAssistant(node) {
      const row = el('div', 'aa-msg');
      const mini = el('div', 'aa-mini', authorInitial);
      mini.setAttribute('aria-hidden', 'true');
      const bubble = el('div', 'aa-bubble aa-bubble--a');
      bubble.appendChild(document.createTextNode(node.reply));
      if (node.signedBy === 'jouke') {
        bubble.appendChild(el('span', 'aa-sign', data.authorName));
      }
      const claim = claimLabel(node.claimMode);
      if (claim) bubble.appendChild(el('span', 'aa-claim', claim));
      row.appendChild(mini);
      row.appendChild(bubble);
      canvas.appendChild(row);

      if (node.proof && node.proof.label) {
        canvas.appendChild(el('span', 'aa-cite', node.proof.label));
      }
      if (node.proof && node.proof.href) {
        const proof = el('a', 'aa-proof', 'Lees het bewijs →');
        proof.href = node.proof.href;
        proof.addEventListener('click', function () {
          track('proof_click', { href: node.proof.href, nodeId: node.id });
        });
        canvas.appendChild(proof);
      }

      if (node.commerce) {
        const card = el('div', 'aa-outcome');
        const role =
          node.commerce.role === 'runner'
            ? 'Runner-up'
            : node.commerce.role === 'alt'
              ? 'Alternatief'
              : 'Topkeuze';
        card.appendChild(el('p', 'aa-outcome-k', role));
        card.appendChild(el('p', 'aa-outcome-n', node.commerce.productLabel));
        if (node.commerce.claim) card.appendChild(el('p', 'aa-outcome-c', node.commerce.claim));
        if (node.commerce.tradeOff) {
          card.appendChild(el('p', 'aa-outcome-tr', 'Trade-off: ' + node.commerce.tradeOff));
        }
        const actions = el('div', 'aa-actions');
        if (node.commerce.cta && node.commerce.cta.href) {
          const buy = el('a', 'aa-buy thi-cta thi-cta--primary');
          buy.href = node.commerce.cta.href;
          buy.target = '_blank';
          buy.rel = 'noopener noreferrer nofollow sponsored';
          buy.appendChild(el('span', 'thi-cta-action', node.commerce.cta.action));
          if (node.commerce.cta.price) {
            buy.appendChild(el('span', 'thi-cta-meta', node.commerce.cta.price));
          }
          buy.addEventListener('click', function () {
            track('buy_click', {
              href: node.commerce.cta.href,
              nodeId: node.id,
              role: node.commerce.role,
            });
          });
          actions.appendChild(buy);
        } else {
          actions.appendChild(el('p', 'aa-outcome-c', 'Koop-link volgt zodra de shop gekoppeld is.'));
        }
        if (node.commerce.secondary && node.commerce.secondary.href) {
          const sec = el('a', 'aa-proof', node.commerce.secondary.label + ' →');
          sec.href = node.commerce.secondary.href;
          sec.style.marginLeft = '0';
          actions.appendChild(sec);
        }
        card.appendChild(actions);
        canvas.appendChild(card);
      }
    }

    function setChips(list) {
      chipsEl.innerHTML = '';
      (list || []).forEach(function (chip) {
        const btn = el('button', 'aa-chip');
        btn.type = 'button';
        if (chip.intentClass === 'decide') btn.classList.add('aa-chip--decide');
        btn.dataset.aaChip = chip.id;
        btn.dataset.intent = chip.intentClass || '';
        btn.dataset.analyticsKey = chip.analyticsKey || chip.id;
        btn.textContent = chip.label || data.labels[chip.id] || chip.id;
        chipsEl.appendChild(btn);
      });
    }

    function disableChips(disabled) {
      chipsEl.querySelectorAll('[data-aa-chip]').forEach(function (btn) {
        btn.disabled = !!disabled;
      });
    }

    async function onChip(chipId, label) {
      const node = data.nodes[chipId];
      if (!node) return;
      disableChips(true);
      appendUser(label);
      track('chip', { chipId: chipId, label: label });
      const typing = appendTyping();
      await new Promise(function (r) {
        setTimeout(r, 420);
      });
      typing.remove();
      appendAssistant(node);
      setChips(node.followUps || []);
      canvas.scrollTop = canvas.scrollHeight;
    }

    chipsEl.addEventListener('click', function (e) {
      const btn = e.target.closest('[data-aa-chip]');
      if (!btn || btn.disabled) return;
      onChip(btn.dataset.aaChip, btn.textContent.trim());
    });
  }

  document.querySelectorAll('[data-aa-root]').forEach(initArtikelagent);
</script>
