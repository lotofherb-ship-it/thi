---
/**
 * Money-page buy module — soft pre-PDP CTA (action + merchant, price secondary).
 * Used by comparison pick cards + honest review hero/footer.
 */
import {
  offerCta,
  merchantDisplayName,
  PICK_DISC_SHORT,
  type ProductOffer,
} from '../lib/products/resolve';

interface Props {
  offers: ProductOffer[];
  disclosure?: string;
  /** Max merchant buttons (default 3). */
  limit?: number;
  emptyHint?: string;
  /** Optional review bridge under CTAs. */
  reviewUrl?: string;
  reviewLabel?: string;
  /** Compact footnote only (default). Pass false to hide card disclosure. */
  showDisc?: boolean;
  /**
   * When true (default), first merchant button is primary.
   * Money-page deep chapters / non-top callouts pass false to keep CTA hierarchy.
   */
  primary?: boolean;
}

const {
  offers,
  disclosure = PICK_DISC_SHORT,
  limit = 3,
  emptyHint = 'Prijs/link volgt zodra de koop-link gekoppeld is.',
  reviewUrl,
  reviewLabel = 'Lees de eerlijke review →',
  showDisc = true,
  primary = true,
} = Astro.props;

/** One CTA per merchant — Awin+Daisycon same shop must not double the button. */
const uniqueByMerchant: ProductOffer[] = [];
const seenShops = new Set<string>();
for (const o of offers) {
  const key = merchantDisplayName(o.merchant).toLowerCase();
  if (seenShops.has(key)) continue;
  seenShops.add(key);
  uniqueByMerchant.push(o);
}

/** Primary + one quiet alt — avoid Partnerlink spam on every button. */
const shown = uniqueByMerchant.slice(0, Math.min(limit, 2));
---

<div class="pick-buy">
  {shown.length > 0 ? (
    shown.map((o, oi) => {
      const { action, price } = offerCta(o, oi === 0 ? 'primary' : 'alt');
      const usePrimary = primary && oi === 0;
      return (
        <a
          class:list={[
            'pick-offer',
            'thi-cta',
            usePrimary ? 'thi-cta--primary' : 'thi-cta--secondary',
            { 'pick-offer--alt': oi > 0 || !usePrimary },
          ]}
          href={o.url}
          target="_blank"
          rel="noopener noreferrer nofollow sponsored"
        >
          <span class="pick-offer-cta thi-cta-action">{action}</span>
          {price ? (
            <span class="pick-offer-meta thi-cta-meta">
              <span class="pick-offer-price">{price}</span>
            </span>
          ) : null}
        </a>
      );
    })
  ) : (
    <p class="pick-disc">{emptyHint}</p>
  )}
  {reviewUrl && (
    <a class="pick-review-link thi-cta thi-cta--tertiary" href={reviewUrl}>{reviewLabel}</a>
  )}
  {showDisc && shown.length > 0 && (
    <p class="pick-disc">
      {disclosure}{' '}
      <a href="/affiliate-disclosure/">Meer info</a>
    </p>
  )}
</div>
