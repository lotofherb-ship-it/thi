---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/site.css';
---

<BaseLayout
  title="Ingeschreven — The Health Issue"
  description="Je staat op de nieuwsbrief."
  noindex={true}
>
  <div class="wc-page">
    <div class="wc-measure wc-nl">
      <div class="wc-kicker">Nieuwsbrief</div>
      <h1 style="font:800 2rem/1.15 var(--font-head);margin:0 0 12px">Bedankt</h1>
      <p class="wc-dek">Je staat op de lijst. Check je inbox als we een bevestiging sturen.</p>
      <p style="margin-top:24px"><a href="/" style="color:var(--green-900)">← Terug naar home</a></p>
    </div>
  </div>
</BaseLayout>
