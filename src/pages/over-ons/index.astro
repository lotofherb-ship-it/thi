---
import StaticPage from '../../components/StaticPage.astro';
import { client, urlFor } from '../../lib/sanity';
import '../../styles/site.css';

const author = await client.fetch(`*[_type=="author" && slug.current=="jouke-de-jong"][0]{
  name, credentials, bio, avatar
}`);

const photo = author?.avatar
  ? urlFor(author.avatar).width(240).height(240).fit('crop').auto('format').url()
  : null;
---

<StaticPage
  title="Over ons — The Health Issue"
  description="Wie The Health Issue maakt en waarom."
  kicker="Over"
  h1="Over The Health Issue"
  dek="Eén merk. Keuzehulp voor gezondheidsproducten — rustig, inspecteerbaar, eerlijk over geld."
>
  <div class="wc-author-block">
    {photo ? (
      <img class="wc-author-photo wc-author-photo--img" src={photo} alt={author.name} width="96" height="96" />
    ) : (
      <div class="wc-author-photo" aria-hidden="true">JdJ</div>
    )}
    <div>
      <p class="wc-author-name">{author?.name || 'Jouke de Jong'}</p>
      <p class="wc-author-role">{author?.credentials || 'Oprichter'} · schrijft de gidsen van The Health Issue</p>
      <p class="wc-author-bio">
        {author?.bio ||
          'Ik beoordeel supplementen en health-producten op etikethelderheid, dosering en prijs per effectieve dosis — niet op commissiehoogte. Affiliate-links staan altijd zichtbaar bij de koopoptie.'}
      </p>
    </div>
  </div>

  <h2>Wat we doen</h2>
  <p>
    We schrijven <strong>vergelijkingen</strong> (meerdere producten) en
    <strong>eerlijke reviews</strong> (één product, dieper), plus praktische gidsen en rekentools —
    met methode op de pagina, niet alleen in de footer.
  </p>

  <h2>Grenzen</h2>
  <ul>
    <li>Geen medisch advies — bij klachten of medicatie: arts of diëtist.</li>
    <li>Geen nep-experts of tweede merknaam naast The Health Issue.</li>
    <li>Geen belofte van labtesten die we niet hebben gedaan.</li>
    <li>AI mag helpen bij research en redactie; we liegen niet over mens vs machine.</li>
  </ul>

  <h2>Contact</h2>
  <p>Vragen of tip? Ga naar <a href="/contact/">contact</a>.</p>
</StaticPage>

<style is:global>
  .wc-author-photo--img {
    display: block;
    object-fit: cover;
    border-radius: 50%;
    width: 96px;
    height: 96px;
    background: var(--cream-2, #f3f0e8);
  }
</style>
