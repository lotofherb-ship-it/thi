---
/**
 * Home — klusjes-first (money-core + keep converters).
 * Featured rail is curated from audit MONEY CORE, not recency junk.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { urlFor } from '../lib/sanity';
import { postHref } from '../lib/urls';
import { getAllPosts } from '../lib/content';
import { pickHomepageFeatures } from '../lib/audit-content';
import type { Post } from '../types';
import '../styles/site.css';

const posts: Post[] = await getAllPosts();
const featured = pickHomepageFeatures(posts, 6);

function formatLabel(post: Post) {
  if (post.template === 'comparison') return 'Vergelijking';
  if (post.template === 'honest-review') return 'Eerlijke review';
  return 'Gids';
}

function dateLabel(iso?: string) {
  if (!iso) return null;
  return new Date(iso).toLocaleDateString('nl-NL', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
}

function cover(post: Post): string | null {
  if (post.heroImage) {
    return urlFor(post.heroImage).width(480).height(360).auto('format').url();
  }
  if (post.coverImageUrl) return post.coverImageUrl;
  if (post.honestReview?.imageUrl) return post.honestReview.imageUrl;
  const first = post.comparisonProducts?.find(p => p.imageUrl);
  return first?.imageUrl || null;
}

const lead = featured[0] ?? null;
const leadImg = lead ? cover(lead) : null;
const leadHref = lead ? postHref(lead) : '/vergelijken/';
const leadLabel = lead ? formatLabel(lead) : 'Vergelijking';
---

<BaseLayout
  title="The Health Issue — Keuzehulp voor gezondheidsproducten"
  description="Onafhankelijke gidsen en reviews. Oordeel eerst, trade-offs erbij, affiliate-geld zichtbaar."
>
  <div class="wc-page">
    <header class="wc-home-hero">
      <div class="wc-home-hero-grid wc-wrap">
        <div class="wc-home-hero-copy">
          {/*
            Nav keeps the wordmark+celery lockup. Hero does NOT reprint it.
            Brand stays hero-level via green Bricolage promise + brand named in dek.
          */}
          <h1 class="wc-home-promise">Keuzehulp zonder marketingruis</h1>
          <p class="wc-home-dek">
            <span class="wc-home-brand-inline">The Health Issue</span>
            vergelijkt supplementen en training gear — oordeel eerst, trade-offs erbij,
            affiliate zichtbaar.
          </p>
          <div class="wc-home-ctas">
            <a class="wc-home-cta wc-home-cta--primary" href="/vergelijken/">
              Bekijk vergelijkingen
            </a>
            <a class="wc-home-cta wc-home-cta--secondary" href="/methode/">
              Zo kiezen wij
            </a>
          </div>
        </div>

        <div class="wc-home-hero-visual">
          <a
            class="wc-home-hero-shot"
            href={leadHref}
            aria-label={lead ? `${leadLabel}: ${lead.title}` : 'Alle vergelijkingen'}
          >
            <div class="wc-home-hero-shot-frame">
              {leadImg ? (
                <img
                  src={leadImg}
                  alt=""
                  width="480"
                  height="360"
                  loading="eager"
                  decoding="async"
                />
              ) : (
                <span class="wc-home-hero-shot-empty" aria-hidden="true" />
              )}
            </div>
            {lead && (
              <span class="wc-home-hero-shot-caption">
                <span class="wc-home-hero-shot-kicker">{leadLabel}</span>
                <span class="wc-home-hero-shot-title">{lead.title}</span>
              </span>
            )}
          </a>
        </div>
      </div>
    </header>

    <div class="wc-wrap">
      <section class="wc-library" id="topkeuzes" aria-label="Money pages en converters">
        <div class="wc-sec-head">
          <h2>Topkeuzes</h2>
          <a href="/vergelijken/">Alle vergelijkingen →</a>
        </div>
        <ul class="wc-library-list">
          {featured.map(post => {
            const img = cover(post);
            const chip = formatLabel(post);
            const updated = post.updatedAt || post.publishedAt;
            const dek = post.excerpt || '';
            return (
              <li>
                <a class="wc-library-card" href={postHref(post)}>
                  <div class="wc-library-body">
                    <span class="wc-format-chip" data-format={chip}>{chip}</span>
                    <h3 class="wc-library-title">{post.title}</h3>
                    {dek && (
                      <p class="wc-library-dek">
                        {dek.slice(0, 120)}{dek.length > 120 ? '…' : ''}
                      </p>
                    )}
                    {updated && (
                      <p class="wc-library-meta">
                        Bijgewerkt {dateLabel(updated)}
                      </p>
                    )}
                  </div>
                  <div class="wc-library-thumb">
                    {img
                      ? <img src={img} alt="" width="160" height="120" loading="eager" />
                      : <span class="wc-library-thumb-empty" aria-hidden="true" />}
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
