---
/**
 * Home: calm 1:1 Wirecutter ATF in THI LOH style.
 * Center = hero_spot (one 3:2 editorial image + headline/byline/dek + Related).
 * Not a product mosaic. No finder chips. No em dashes.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { urlFor } from '../lib/sanity';
import { postHref } from '../lib/urls';
import { getAllPosts } from '../lib/content';
import {
  homepageTopPick,
  isMoneyCorePath,
  normalizePostPath,
  pickHomepageFeatures,
} from '../lib/audit-content';
import type { Post } from '../types';
import '../styles/site.css';

const posts: Post[] = await getAllPosts();
const featured = pickHomepageFeatures(posts, 15);

/** Short card/list title: drop year + SEO clause; never emit em dashes. */
function cardTitle(post: Post): string {
  const raw = post.title || '';
  const head = raw.split(':')[0] || raw;
  return (
    head
      .replace(/\u2014/g, ',') // Jouke: no em dashes on the website
      .replace(/\s*\(20\d{2}\)\s*/g, ' ')
      .replace(/\s*20\d{2}\s*/g, ' ')
      .replace(/\s+van\s*$/i, '')
      .replace(/\s+,/g, ',')
      .replace(/\s+/g, ' ')
      .trim() || raw.replace(/\u2014/g, ',')
  );
}

function noEmDash(s: string): string {
  return s.replace(/\u2014/g, ',').replace(/\s+/g, ' ').trim();
}

function cover(post: Post, size = 640): string | null {
  if (post.heroImage) {
    return urlFor(post.heroImage).width(size).height(size).auto('format').url();
  }
  if (post.coverImageUrl) return post.coverImageUrl;
  if (post.honestReview?.imageUrl) return post.honestReview.imageUrl;
  const first = post.comparisonProducts?.find(p => p.imageUrl);
  return first?.imageUrl || null;
}

/** WC hero_spot uses ~3:2 editorial crop. */
function coverHero(post: Post): string | null {
  if (post.heroImage) {
    return urlFor(post.heroImage).width(960).height(640).fit('crop').auto('format').url();
  }
  return cover(post, 960);
}

function dateLabel(iso?: string): string | null {
  if (!iso) return null;
  const then = new Date(iso).getTime();
  if (Number.isNaN(then)) return null;
  const days = Math.round((Date.now() - then) / 86400000);
  if (days <= 0) return 'Vandaag';
  if (days === 1) return 'Gisteren';
  if (days < 7) return `${days} dagen geleden`;
  return new Date(iso).toLocaleDateString('nl-NL', {
    day: 'numeric',
    month: 'short',
  });
}

function heroDek(post: Post): string | null {
  const raw = post.excerpt || post.seoDescription || post.quickAnswer || '';
  if (!raw) return null;
  const cleaned = noEmDash(raw);
  return cleaned.length > 180 ? `${cleaned.slice(0, 177).trim()}…` : cleaned;
}

/** Prefer a more editorial/honest-review piece for center hero when available. */
function pickHero(list: Post[]): Post | null {
  const editorial = list.find(
    p => p.template === 'honest-review' || p.template === 'standard' || p.template === 'nutrient',
  );
  return editorial ?? list[0] ?? null;
}

const hero = pickHero(featured);
const fameLead = featured.find(p => p._id !== hero?._id) ?? featured[0] ?? null;

const related = featured
  .filter(p => p._id !== hero?._id)
  .slice(0, 3);

const excludeIds = new Set(
  [hero, ...related].filter(Boolean).map(p => p!._id),
);

const latest = [...posts]
  .sort((a, b) => {
    const da = a.updatedAt || a.publishedAt || '';
    const db = b.updatedAt || b.publishedAt || '';
    return db.localeCompare(da);
  })
  .filter(p => !excludeIds.has(p._id))
  .slice(0, 3);

const relevant = featured
  .filter(p => isMoneyCorePath(normalizePostPath(postHref(p))))
  .filter(p => p._id !== hero?._id)
  .slice(0, 3);

const belowFold = featured
  .filter(p => p._id !== hero?._id)
  .slice(0, 4);
---

<BaseLayout
  title="The Health Issue: Keuzehulp voor gezondheidsproducten"
  description="Onafhankelijke gidsen en reviews. Oordeel eerst, trade-offs erbij, affiliate-geld zichtbaar."
>
  <div class="wc-page wc-home-grid">
    <div class="wc-wrap">
      {/* Finder-style field (WC Ask Finder → THI guide search). No chip spam. */}
      <form class="wc-home-finder" action="/vergelijken/" method="get" role="search">
        <label class="wc-home-finder-label" for="home-finder">
          Zoek een gids
        </label>
        <div class="wc-home-finder-field">
          <span class="wc-home-finder-icon" aria-hidden="true">⌕</span>
          <input
            id="home-finder"
            class="wc-home-finder-input"
            type="search"
            name="q"
            placeholder="Zoek een gids: magnesium, roeitrainer, ashwagandha…"
            autocomplete="off"
          />
          <a class="wc-home-finder-go" href="/vergelijken/">Vergelijken</a>
        </div>
      </form>

      <p class="wc-home-trust">
        We beoordelen onafhankelijk. Via onze links kunnen we commissie krijgen, zonder extra kosten voor jou.
      </p>

      {/* THREE-COLUMN ATF: left lists / center hero_spot / right deals */}
      <div class="wc-home-rails">
        {/* Left: Onze topkeuzes + sparse Het laatste */}
        <aside class="wc-home-rail wc-home-rail-left">
          {fameLead && (
            <a class="wc-home-fame" href="/vergelijken/">
              <div class="wc-home-fame-media">
                {cover(fameLead, 240) ? (
                  <img
                    src={cover(fameLead, 240)!}
                    alt=""
                    width="192"
                    height="192"
                    loading="eager"
                    decoding="async"
                  />
                ) : (
                  <span class="wc-home-card-media-empty" aria-hidden="true" />
                )}
              </div>
              <div class="wc-home-fame-copy">
                <h2 class="wc-home-fame-title">Onze topkeuzes</h2>
                <p class="wc-home-fame-dek">
                  Gidsen die we blijven aanraden: oordeel eerst, trade-offs erbij, affiliate zichtbaar.
                </p>
              </div>
            </a>
          )}

          <section class="wc-home-latest" aria-labelledby="latest-title">
            <h2 id="latest-title" class="wc-home-rail-h">Het laatste</h2>
            <ul class="wc-home-latest-list">
              {latest.map(post => (
                <li>
                  <a href={postHref(post)}>
                    <span class="wc-home-latest-title">{cardTitle(post)}</span>
                    {dateLabel(post.updatedAt || post.publishedAt) && (
                      <span class="wc-home-latest-meta">
                        {dateLabel(post.updatedAt || post.publishedAt)}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        </aside>

        {/* Center: WC hero_spot — one 3:2 editorial image, not a product mosaic */}
        <section class="wc-home-rail wc-home-rail-center" aria-label="Uitgelicht verhaal">
          {hero && (
            <article class="wc-home-hero">
              <a class="wc-home-hero-media" href={postHref(hero)} title={hero.title}>
                {coverHero(hero) ? (
                  <img
                    src={coverHero(hero)!}
                    alt=""
                    width="960"
                    height="640"
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                  />
                ) : (
                  <span class="wc-home-card-media-empty" aria-hidden="true" />
                )}
              </a>
              <h2 class="wc-home-hero-title">
                <a href={postHref(hero)}>{cardTitle(hero)}</a>
              </h2>
              {hero.author?.name && (
                <p class="wc-home-hero-byline">door {hero.author.name}</p>
              )}
              {heroDek(hero) && (
                <p class="wc-home-hero-dek">{heroDek(hero)}</p>
              )}
              {related.length > 0 && (
                <div class="wc-home-hero-related">
                  <p class="wc-home-hero-related-label">Gerelateerd</p>
                  <ul class="wc-home-hero-related-list">
                    {related.map(post => (
                      <li>
                        <a href={postHref(post)}>{cardTitle(post)}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </article>
          )}
        </section>

        {/* Right: short Nu relevant list (WC Daily deals density) */}
        <aside class="wc-home-rail wc-home-rail-right">
          <section class="wc-home-relevant" aria-labelledby="relevant-title">
            <h2 id="relevant-title" class="wc-home-rail-h">Nu relevant</h2>
            <p class="wc-home-relevant-dek">Topkeuzes uit onze money guides.</p>
            <ul class="wc-home-relevant-list">
              {relevant.map(post => {
                const img = cover(post, 160);
                const pick = homepageTopPick(post);
                return (
                  <li>
                    <a class="wc-home-relevant-item" href={postHref(post)} title={post.title}>
                      <div class="wc-home-relevant-body">
                        <span class="wc-home-relevant-title">{cardTitle(post)}</span>
                        {pick && (
                          <span class="wc-home-relevant-pick">
                            <em>Topkeuze:</em> {pick}
                          </span>
                        )}
                      </div>
                      <div class="wc-home-relevant-thumb">
                        {img ? (
                          <img src={img} alt="" width="72" height="72" loading="eager" decoding="async" />
                        ) : (
                          <span class="wc-home-card-media-empty" aria-hidden="true" />
                        )}
                      </div>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        </aside>
      </div>

      {/* Below fold only: short library, pushed well under ATF */}
      {belowFold.length > 0 && (
        <section class="wc-home-library" aria-labelledby="library-title">
          <div class="wc-home-library-head">
            <h2 id="library-title">Meer gidsen</h2>
            <a href="/vergelijken/">Alle vergelijkingen</a>
          </div>
          <ul class="wc-home-cards">
            {belowFold.map((post, i) => {
              const img = cover(post, 480);
              const pick = homepageTopPick(post);
              return (
                <li>
                  <a class="wc-home-card" href={postHref(post)} title={post.title}>
                    <div class="wc-home-card-media">
                      {img ? (
                        <img
                          src={img}
                          alt=""
                          width="480"
                          height="480"
                          loading={i < 2 ? 'eager' : 'lazy'}
                          decoding="async"
                        />
                      ) : (
                        <span class="wc-home-card-media-empty" aria-hidden="true" />
                      )}
                    </div>
                    <div class="wc-home-card-body">
                      <h3 class="wc-home-card-title">{cardTitle(post)}</h3>
                      {pick && (
                        <p class="wc-home-card-verdict">
                          <em>Topkeuze:</em> {pick}
                        </p>
                      )}
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )}
    </div>
  </div>
</BaseLayout>
