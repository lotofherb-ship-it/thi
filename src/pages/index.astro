---
/**
 * Home: Wirecutter-style dense guide library grid.
 * Slim nav (layout) + quiet dek + chips + image-led cards. No lean hero.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { urlFor } from '../lib/sanity';
import { postHref } from '../lib/urls';
import { getAllPosts } from '../lib/content';
import { homepageTopPick, pickHomepageFeatures } from '../lib/audit-content';
import type { Post } from '../types';
import '../styles/site.css';

const posts: Post[] = await getAllPosts();
const featured = pickHomepageFeatures(posts, 12);

/** Short card title: drop year + trailing SEO clause after colon. */
function cardTitle(post: Post): string {
  const raw = post.title || '';
  const head = raw.split(':')[0] || raw;
  return (
    head
      .replace(/\s*\(20\d{2}\)\s*/g, ' ')
      .replace(/\s*20\d{2}\s*/g, ' ')
      .replace(/\s+van\s*$/i, '')
      .replace(/\s+/g, ' ')
      .trim() || raw
  );
}

function cover(post: Post): string | null {
  if (post.heroImage) {
    return urlFor(post.heroImage).width(480).height(480).auto('format').url();
  }
  if (post.coverImageUrl) return post.coverImageUrl;
  if (post.honestReview?.imageUrl) return post.honestReview.imageUrl;
  const first = post.comparisonProducts?.find(p => p.imageUrl);
  return first?.imageUrl || null;
}

const categoryChips = [
  { href: '/supplementen/', label: 'Supplementen' },
  { href: '/training/', label: 'Training' },
  { href: '/gezondheid/', label: 'Gezondheid' },
  { href: '/vergelijken/', label: 'Vergelijken' },
];
---

<BaseLayout
  title="The Health Issue: Keuzehulp voor gezondheidsproducten"
  description="Onafhankelijke gidsen en reviews. Oordeel eerst, trade-offs erbij, affiliate-geld zichtbaar."
>
  <div class="wc-page wc-home-grid">
    <div class="wc-wrap">
      <p class="wc-home-dek">
        Onafhankelijke gidsen voor supplementen en training gear.
      </p>

      <nav class="wc-home-cats" aria-label="Categorieën">
        {categoryChips.map(({ href, label }) => (
          <a class="wc-home-cat" href={href}>{label}</a>
        ))}
      </nav>

      <section class="wc-home-library" aria-labelledby="library-title">
        <div class="wc-home-library-head">
          <h1 id="library-title">Gidsen</h1>
          <a href="/vergelijken/">Alle vergelijkingen</a>
        </div>

        <ul class="wc-home-cards">
          {featured.map((post, i) => {
            const img = cover(post);
            const pick = homepageTopPick(post);
            const title = cardTitle(post);
            return (
              <li>
                <a class="wc-home-card" href={postHref(post)} title={post.title}>
                  <div class="wc-home-card-media">
                    {img ? (
                      <img
                        src={img}
                        alt=""
                        width="480"
                        height="480"
                        loading={i < 8 ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                    ) : (
                      <span class="wc-home-card-media-empty" aria-hidden="true" />
                    )}
                  </div>
                  <div class="wc-home-card-body">
                    <h2 class="wc-home-card-title">{title}</h2>
                    {pick && (
                      <p class="wc-home-card-verdict">
                        <em>Topkeuze:</em> {pick}
                      </p>
                    )}
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
