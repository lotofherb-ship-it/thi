---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/site.css';
import '../../../styles/guide.css';
---

<BaseLayout
  title="Eiwitrekenmachine — The Health Issue"
  description="Bereken een indicatieve eiwitbehoefte per dag."
>
  <div class="wc-page">
    <div class="wc-measure wc-static">
      <nav class="wc-crumb" aria-label="Kruimelpad">
        <a href="/">Home</a>
        <span class="wc-crumb-sep">/</span>
        <a href="/voeding/">Voeding</a>
        <span class="wc-crumb-sep">/</span>
        <a href="/voeding/calculators/">Rekentools</a>
        <span class="wc-crumb-sep">/</span>
        <span aria-current="page">Eiwit</span>
      </nav>
      <div class="wc-kicker">Calculator</div>
      <h1 style="font:800 clamp(1.75rem,3.5vw,2.25rem)/1.15 var(--font-head);margin:0 0 12px">
        Hoeveel eiwit per dag?
      </h1>
      <p class="wc-dek" style="margin-bottom:16px">
        Indicatief. Geen dieetadvies. Bij ziekte of dieetbeperkingen: diëtist.
      </p>
      <p class="guide-bridge" style="margin-bottom:28px">
        Lees ook de gids:
        <a href="/voeding/hoeveel-eiwit-per-dag/">hoeveel eiwit per dag</a>
      </p>

      <form id="prot-form" class="calc-form">
        <label>
          Lichaamsgewicht (kg)
          <input type="number" id="weight" name="weight" min="30" max="200" step="0.1" value="75" required />
        </label>
        <label>
          Doel
          <select id="goal" name="goal">
            <option value="1.2">Onderhoud / licht actief (1,2 g/kg)</option>
            <option value="1.6" selected>Krachttraining / spiermassa (1,6 g/kg)</option>
            <option value="2.0">Intensief / cut (2,0 g/kg)</option>
            <option value="2.2">Hoog (2,2 g/kg)</option>
          </select>
        </label>
        <button type="submit">Bereken</button>
      </form>

      <div id="prot-result" class="calc-result" hidden>
        <p class="calc-result-label">Indicatie per dag</p>
        <p class="calc-result-num"><span id="prot-grams">—</span> g eiwit</p>
        <p class="calc-result-note">Verspreid over 3–4 maaltijden. Lees ook: <a href="/voeding/hoeveel-eiwit-per-dag/">hoeveel eiwit per dag</a>.</p>
      </div>

      <aside class="guide-fyi" style="margin-top:32px">
        <div class="guide-fyi-label">Let op</div>
        <p>Dit is een vuistregel op basis van veelgebruikte ranges in sportvoeding — geen persoonlijk advies.</p>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .calc-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 22rem;
    margin-bottom: 24px;
  }
  .calc-form label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font: 600 13px/1.3 var(--font-body);
    color: var(--text);
  }
  .calc-form input,
  .calc-form select {
    padding: 11px 12px;
    border: 1px solid var(--cream-3);
    background: var(--white);
    font: 400 15px/1.3 var(--font-body);
  }
  .calc-form button {
    padding: 12px 16px;
    background: var(--celery);
    color: var(--green-900);
    border: 1px solid var(--celery-d);
    font: 700 14px/1 var(--font-body);
    cursor: pointer;
  }
  .calc-result {
    padding: 18px 0;
    border-top: 1px solid var(--cream-3);
    border-bottom: 1px solid var(--cream-3);
  }
  .calc-result-label {
    font: 700 11px/1 var(--font-body);
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--muted);
    margin: 0 0 8px;
  }
  .calc-result-num {
    font: 800 2rem/1 var(--font-head);
    color: var(--text);
    margin: 0 0 10px;
  }
  .calc-result-note {
    font: 400 14px/1.5 var(--font-body);
    color: var(--body);
    margin: 0;
  }
  .calc-result-note a { color: var(--green-900); }
</style>

<script>
  const form = document.getElementById('prot-form') as HTMLFormElement | null;
  const result = document.getElementById('prot-result');
  const grams = document.getElementById('prot-grams');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const w = Number((document.getElementById('weight') as HTMLInputElement).value);
    const g = Number((document.getElementById('goal') as HTMLSelectElement).value);
    if (!w || !g) return;
    const total = Math.round(w * g);
    if (grams) grams.textContent = String(total);
    result?.removeAttribute('hidden');
  });
</script>
