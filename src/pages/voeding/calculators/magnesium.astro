---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/site.css';
import '../../../styles/guide.css';
---

<BaseLayout
  title="Magnesium-check — The Health Issue"
  description="Indicatie voor dagelijkse magnesiumbehoefte."
>
  <div class="wc-page">
    <div class="wc-measure wc-static">
      <nav class="wc-crumb" aria-label="Kruimelpad">
        <a href="/">Home</a>
        <span class="wc-crumb-sep">/</span>
        <a href="/voeding/">Voeding</a>
        <span class="wc-crumb-sep">/</span>
        <a href="/voeding/calculators/">Rekentools</a>
        <span class="wc-crumb-sep">/</span>
        <span aria-current="page">Magnesium</span>
      </nav>
      <div class="wc-kicker">Calculator</div>
      <h1 style="font:800 clamp(1.75rem,3.5vw,2.25rem)/1.15 var(--font-head);margin:0 0 12px">
        Magnesium — snelle check
      </h1>
      <p class="wc-dek" style="margin-bottom:16px">
        Indicatieve behoefte aan <strong>elementair</strong> magnesium. Geen medisch advies.
      </p>
      <p class="guide-bridge" style="margin-bottom:28px">
        Daarna product kiezen:
        <a href="/supplementen/beste-magnesium-bisglycinaat/">beste magnesiumbisglycinaat</a>
        ·
        <a href="/supplementen/hoeveel-magnesium-per-dag/">hoeveel magnesium per dag</a>
      </p>

      <form id="mag-form" class="calc-form">
        <label>
          Geslacht (richtlijn)
          <select id="sex">
            <option value="310">Man (~310 mg)</option>
            <option value="270" selected>Vrouw (~270 mg)</option>
          </select>
        </label>
        <label>
          Situatie
          <select id="extra">
            <option value="0">Geen bijzonderheden</option>
            <option value="30">Veel sport / zweten (+30 mg)</option>
            <option value="40">Zwangerschap (indicatief +40 mg)</option>
          </select>
        </label>
        <button type="submit">Bereken</button>
      </form>

      <div id="mag-result" class="calc-result" hidden>
        <p class="calc-result-label">Richtlijn elementair / dag</p>
        <p class="calc-result-num"><span id="mag-mg">—</span> mg</p>
        <p class="calc-result-note">
          Kies daarna een vorm: <a href="/supplementen/beste-magnesium-bisglycinaat/">beste magnesiumbisglycinaat</a>
          · of lees <a href="/supplementen/hoeveel-magnesium-per-dag/">hoeveel magnesium per dag</a>.
        </p>
      </div>

      <aside class="guide-fyi" style="margin-top:32px">
        <div class="guide-fyi-label">Let op</div>
        <p>Supplementdosering is niet hetzelfde als behoefte uit voeding. Bij nierproblemen of medicatie: arts.</p>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .calc-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 22rem;
    margin-bottom: 24px;
  }
  .calc-form label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font: 600 13px/1.3 var(--font-body);
    color: var(--text);
  }
  .calc-form select {
    padding: 11px 12px;
    border: 1px solid var(--cream-3);
    background: var(--white);
    font: 400 15px/1.3 var(--font-body);
  }
  .calc-form button {
    padding: 12px 16px;
    background: var(--celery);
    color: var(--green-900);
    border: 1px solid var(--celery-d);
    font: 700 14px/1 var(--font-body);
    cursor: pointer;
  }
  .calc-result {
    padding: 18px 0;
    border-top: 1px solid var(--cream-3);
    border-bottom: 1px solid var(--cream-3);
  }
  .calc-result-label {
    font: 700 11px/1 var(--font-body);
    text-transform: uppercase;
    letter-spacing: .06em;
    color: var(--muted);
    margin: 0 0 8px;
  }
  .calc-result-num {
    font: 800 2rem/1 var(--font-head);
    color: var(--text);
    margin: 0 0 10px;
  }
  .calc-result-note {
    font: 400 14px/1.5 var(--font-body);
    color: var(--body);
    margin: 0;
  }
  .calc-result-note a { color: var(--green-900); }
</style>

<script>
  const form = document.getElementById('mag-form') as HTMLFormElement | null;
  const result = document.getElementById('mag-result');
  const out = document.getElementById('mag-mg');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const base = Number((document.getElementById('sex') as HTMLSelectElement).value);
    const extra = Number((document.getElementById('extra') as HTMLSelectElement).value);
    if (out) out.textContent = String(base + extra);
    result?.removeAttribute('hidden');
  });
</script>
