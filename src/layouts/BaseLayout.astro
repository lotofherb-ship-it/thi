---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { SITE_URL, absoluteUrl, sitewideGraph } from '../lib/schema';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  /** Open Graph type — use `article` on posts. */
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'The Health Issue: onafhankelijke informatie over supplementen, voeding en training.',
  image = '/og-default.jpg',
  canonical,
  noindex = false,
  ogType = 'website',
} = Astro.props;

// Canonicals always use production host (even when previewing on pages.dev).
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = absoluteUrl(image) || `${SITE_URL}/og-default.jpg`;
const siteGraph = sitewideGraph();
---

<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}

  <!-- Canonical (production host) -->
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type"        content={ogType} />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={ogImage} />
  <meta property="og:url"         content={canonicalUrl} />
  <meta property="og:locale"      content="nl_NL" />
  <meta property="og:site_name"   content="The Health Issue" />

  <!-- Twitter -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImage} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/logo.png" />

  <title>{title}</title>

  <!-- Sitewide Organization + WebSite -->
  <script type="application/ld+json" set:html={JSON.stringify(siteGraph)} />

  <!-- Self-hosted fonts: no Google Fonts / jsDelivr preconnect -->
  <link rel="preload" href="/fonts/bricolage-grotesque-normal-700-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/lato-normal-400-latin.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <header class="thi-chrome">
    <SiteNav />
  </header>
  <main>
    <slot />
  </main>
  <SiteFooter />
  <CookieConsent />

  <!-- Reading progress script (global) -->
  <script>
    const bar = document.querySelector<HTMLElement>('.reading-progress');
    if (bar) {
      const updateProgress = () => {
        const scrolled = window.scrollY;
        const total = document.documentElement.scrollHeight - window.innerHeight;
        const pct = total > 0 ? Math.round((scrolled / total) * 100) : 0;
        bar.style.setProperty('--progress', `${pct}%`);
      };
      window.addEventListener('scroll', updateProgress, { passive: true });
    }
  </script>
</body>
</html>
